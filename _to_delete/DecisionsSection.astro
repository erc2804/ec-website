---
// --- What I decide before the AI writes: one request from Klaro, a CSV export,
// in the shape of the inquiry chat's bubble. Under it the questions I clarify
// first, one per concern (audience, business case, scale, accessibility,
// team). Then the file as accounting opens it in Excel, built from the request
// alone and built with the answers. The spreadsheets are decoration; the
// sentence under each says what it shows. Not interactive on purpose: both
// outcomes are the point.
import Section from "../../components/ui/Section.astro"
import { useTranslations } from "../../i18n"

const t = useTranslations(Astro.currentLocale).development.decisions

// --- The fictional time entries. Left as plain UTF-8 with commas, the way
// German Excel opens it: one column, umlauts broken. Right as the answers ask.
const plainRows = [
  "Kunde,Projekt,Stunden",
  "MÃ¼ller GmbH,Relaunch,12.5",
  "MÃ¼ller GmbH,Wartung,3.25",
  "BÃ¤ckerei Schulz,Website,8",
]
const briefRows = [
  ["Kunde", "Projekt", "Stunden"],
  ["Müller GmbH", "Relaunch", "12,5"],
  ["Müller GmbH", "Wartung", "3,25"],
]
const columns = ["A", "B", "C"]
---

<Section tone="light" aria-labelledby="decisionsTitle">
  <h2 id="decisionsTitle" class="ec-reveal text-heading-1 text-balance">{t.title}</h2>
  <p class="mt-5 max-w-[56ch] ec-reveal text-lead text-typo-medium ec-reveal-late">{t.lead}</p>

  <p
    class="mt-12 w-fit max-w-full ec-reveal rounded-2xl rounded-bl-sm bg-gray-subtle px-5 py-4 text-lead text-typo-high"
  >
    {t.prompt}
  </p>

  <h3 class="mt-12 ec-reveal text-heading-2">{t.pointsTitle}</h3>
  <dl class="mt-6 grid max-w-3xl ec-reveal border-t border-gray-low">
    {
      t.points.map((point) => (
        <div class="grid gap-1 border-b border-gray-low py-4 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-6">
          <dt class="text-typo-medium">{point.topic}</dt>
          <dd class="text-typo-high">{point.text}</dd>
        </div>
      ))
    }
  </dl>

  <div class="mt-14 grid gap-10 md:grid-cols-2 md:gap-8">
    <div class="flex ec-reveal flex-col gap-4">
      <p class="text-sm text-typo-medium">{t.plainLabel}</p>
      <div class="ec-sheet" aria-hidden="true" inert>
        <div class="ec-sheet-row ec-sheet-head">
          <span></span>
          {columns.map((column) => <span>{column}</span>)}
        </div>
        {
          plainRows.map((row, index) => (
            <div class="ec-sheet-row">
              <span class="ec-sheet-number">{index + 1}</span>
              <span class="ec-sheet-overflow">{row}</span>
            </div>
          ))
        }
      </div>
      <p class="text-typo-medium">{t.plainResult}</p>
    </div>

    <div class="flex ec-reveal flex-col gap-4 [--ec-reveal-delay:110ms]">
      <p class="text-sm text-typo-medium">{t.briefLabel}</p>
      <div class="ec-sheet" aria-hidden="true" inert>
        <div class="ec-sheet-row ec-sheet-head">
          <span></span>
          {columns.map((column) => <span>{column}</span>)}
        </div>
        {
          briefRows.map((row, index) => (
            <div class="ec-sheet-row">
              <span class="ec-sheet-number">{index + 1}</span>
              {row.map((cell, cellIndex) => (
                <span class:list={[cellIndex === 2 && index > 0 && "text-right"]}>{cell}</span>
              ))}
            </div>
          ))
        }
        <div class="ec-sheet-row">
          <span class="ec-sheet-number">4</span>
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
      <p class="text-typo-medium">{t.briefResult}</p>
    </div>
  </div>

  <p
    class="mt-12 max-w-[56ch] ec-reveal border-l-3 border-brand-green-medium pl-4 text-lead text-typo-high ec-reveal-late"
  >
    {t.closing}
  </p>
</Section>

<style>
  /* --- A spreadsheet as Excel draws it: column letters, row numbers, thin
     grid lines, the system's own type --- */
  .ec-sheet {
    overflow: hidden;
    border: 1px solid #d4d4d4;
    border-radius: 0.5rem;
    background: #ffffff;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.8125rem;
    letter-spacing: 0;
    color: #1f1f1f;
  }

  .ec-sheet-row {
    display: grid;
    grid-template-columns: 2rem repeat(3, minmax(0, 1fr));
  }

  .ec-sheet-row > span {
    min-height: 1.75rem;
    overflow: hidden;
    border-right: 1px solid #e1e1e1;
    border-bottom: 1px solid #e1e1e1;
    padding: 0.25rem 0.5rem;
    white-space: nowrap;
  }

  .ec-sheet-row:last-child > span {
    border-bottom: 0;
  }

  .ec-sheet-head > span,
  .ec-sheet-number {
    background: #f3f3f3;
    text-align: center;
    color: #616161;
  }

  /* --- Text too long for its cell runs on over the empty cells beside it,
     as it does in Excel --- */
  .ec-sheet-overflow {
    grid-column: span 3;
  }
</style>
