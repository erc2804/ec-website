---
// --- Before and after of the same page, one on top of the other: the top of
// my own home page as an AI model built it from the same content without any
// design brief (left), and as I designed it (right). Both are the first
// screen of a 1280 × 960 window, one pair per language. The info button next
// to "AI-generated" opens a dialog: which model, when, and the prompt. A line splits
// them and can be dragged; once it is well in view Pixel-Ercan's cursor (the
// same one as in the hero) comes in, grabs the knob and pulls it left and
// right, once, so it is clear that it moves. Any touch stops it, and under
// reduced motion nothing moves and there is no cursor.
//
// The control is a real range input laid over the picture: arrow keys, screen
// readers and touch work as they do everywhere. The pictures are hidden from
// screen readers; a sentence tells them what the comparison shows.
import { IconArrowsHorizontal, IconInfoCircle } from "@tabler/icons-astro"
import Dialog from "../../components/ui/Dialog.astro"
import ToolCursor from "../../components/ui/ToolCursor.astro"
import { siteConfig } from "../../config/site"
import { useTranslations } from "../../i18n"

interface Props {
  class?: string
}

const { class: additionalClasses } = Astro.props
const t = useTranslations(Astro.currentLocale).design.compare
const cursorName = siteConfig.name.split(" ")[0]
const locale = Astro.currentLocale === "en" ? "en" : "de"
---

<figure class:list={["ec-compare m-0", additionalClasses]}>
  <!-- --- Which side is which, above the window so nothing on the pages is
       covered. Plain words, no chips: a chip would look like something to click.
       The words are for the eye (the range input names both sides); the info
       button is real and reachable, nudged up to the optical middle of the
       words, which sit high in their line. -->
  <div class="mb-1 flex items-center justify-between gap-6 font-bold text-typo-high">
    <span class="flex items-center">
      <span aria-hidden="true">{t.before}</span>
      <button
        type="button"
        class="grid size-11 -translate-y-[1.5px] place-items-center rounded-full text-typo-medium transition-colors hover:bg-gray-subtle hover:text-typo-high"
        aria-label={t.originLabel}
        aria-haspopup="dialog"
        data-dialog-open="compareOrigin"
      >
        <IconInfoCircle class="size-5" aria-hidden="true" />
      </button>
    </span>
    <span class="text-right" aria-hidden="true">{t.after}</span>
  </div>

  <!-- --- A browser window: the title bar with three dots, the page below -->
  <div class="overflow-hidden rounded-2xl bg-gray-min shadow-lg ring-1 ring-black/5 select-none">
    <div
      class="flex items-center gap-1.5 border-b border-gray-subtle px-4 py-2.5"
      aria-hidden="true"
    >
      <span class="size-2.5 rounded-full bg-gray-low"></span>
      <span class="size-2.5 rounded-full bg-gray-low"></span>
      <span class="size-2.5 rounded-full bg-gray-low"></span>
      <span class="mx-auto h-5 w-2/5 rounded-md bg-gray-subtle"></span>
    </div>
    <div class="relative">
      <img
        src={`/images/design/compare-ai-${locale}.webp`}
        alt=""
        width="1536"
        height="1152"
        loading="lazy"
        decoding="async"
        class="block h-auto w-full"
      />
      <div class="ec-compare-after absolute inset-0" aria-hidden="true" inert>
        <img
          src={`/images/design/compare-designed-${locale}.webp`}
          alt=""
          width="1536"
          height="1152"
          loading="lazy"
          decoding="async"
          class="block size-full object-cover"
        />
      </div>

      <input
        type="range"
        min="0"
        max="100"
        step="1"
        value="50"
        class="ec-compare-range absolute inset-0 z-20 m-0 size-full cursor-ew-resize opacity-0"
        aria-label={t.sliderLabel}
        aria-describedby="compareDescription"
      />
      <span
        class="ec-compare-line pointer-events-none absolute inset-y-0 z-10 w-0.5 bg-white"
        aria-hidden="true"
      >
        <span
          class="ec-compare-knob absolute top-1/2 left-1/2 grid size-11 -translate-1/2 place-items-center rounded-full bg-white text-brand-blue shadow-md"
        >
          <IconArrowsHorizontal class="size-5" />
        </span>
      </span>
      <ToolCursor name={cursorName} class="ec-compare-cursor z-30 opacity-0" />
    </div>
  </div>
  <figcaption id="compareDescription" class="sr-only">{t.description}</figcaption>

  <Dialog id="compareOrigin" title={t.originTitle}>
    {t.originText.map((paragraph) => <p>{paragraph}</p>)}
    <h3 class="mt-2 font-bold text-typo-high">{t.promptTitle}</h3>
    <!-- --- Sent in German for both languages, so it carries lang -->
    <pre
      class="rounded-xl bg-gray-subtle p-4 font-mono text-[0.8125rem] leading-relaxed whitespace-pre-wrap text-typo-high"
      lang="de">{t.prompt}</pre>
  </Dialog>
</figure>

<style>
  .ec-compare {
    --ec-compare-position: 50%;
  }

  .ec-compare-after {
    clip-path: inset(0 0 0 var(--ec-compare-position));
  }

  .ec-compare-line {
    left: var(--ec-compare-position);
    translate: -50% 0;
    box-shadow: 0 0 0 1px rgb(5 56 107 / 0.15);
  }

  .ec-compare :global(.ec-compare-cursor) {
    transition: opacity 300ms ease;
  }

  /* --- The knob shows the focus of the invisible range input --- */
  .ec-compare-range:focus-visible + .ec-compare-line .ec-compare-knob {
    outline: 4px solid var(--color-brand-green-high);
    outline-offset: 3px;
  }
</style>

<script>
  for (const compare of document.querySelectorAll<HTMLElement>(".ec-compare")) {
    const range = compare.querySelector<HTMLInputElement>(".ec-compare-range")!
    const set = (position: number) => {
      compare.style.setProperty("--ec-compare-position", `${position}%`)
      range.value = String(Math.round(position))
    }

    let isTouched = false
    const touch = () => {
      isTouched = true
    }
    range.addEventListener("input", () => {
      touch()
      set(Number(range.value))
    })
    range.addEventListener("pointerdown", touch)
    range.addEventListener("keydown", touch)

    // --- One drag by the cursor: it glides to the knob, presses, pulls the
    // line left, right and back to the middle, lets go and drifts off. All of
    // it is over in under four seconds, so it needs no pause control
    // (WCAG 2.2.2). Each leg has the same in-and-out curve as the site's other
    // soft moves. Positions are in pixels of the picture, the cursor's
    // tip sits on the knob.
    const cursor = compare.querySelector<HTMLElement>(".ec-compare-cursor")!
    const picture = cursor.parentElement!
    const ease = (time: number) =>
      time < 0.5 ? 2 * time * time : 1 - Math.pow(-2 * time + 2, 2) / 2
    const knobPoint = (position: number) => ({
      x: (picture.clientWidth * position) / 100,
      y: picture.clientHeight / 2,
    })
    const moveCursor = (x: number, y: number) => {
      cursor.style.translate = `${Math.round(x + 2)}px ${Math.round(y + 2)}px`
    }

    type Leg = {
      duration: number
      from: number
      to: number
      press?: boolean
      cursorOnly?: "in" | "out"
    }
    const legs: Leg[] = [
      { duration: 700, from: 50, to: 50, cursorOnly: "in" },
      { duration: 800, from: 50, to: 22, press: true },
      { duration: 800, from: 22, to: 78, press: true },
      { duration: 800, from: 78, to: 50, press: true },
      { duration: 600, from: 50, to: 50, cursorOnly: "out" },
    ]

    const sweep = () => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return
      let leg = 0
      let legStart = 0
      const frame = (now: number) => {
        if (isTouched) {
          cursor.style.opacity = "0"
          cursor.dataset.isPressed = "false"
          return
        }
        if (!legStart) {
          legStart = now
          cursor.dataset.isPressed = legs[leg].press ? "true" : "false"
        }
        const current = legs[leg]
        const progress = ease(Math.min((now - legStart) / current.duration, 1))
        const knob = knobPoint(current.from + (current.to - current.from) * progress)
        if (current.cursorOnly === "in") {
          // --- From below right onto the knob
          moveCursor(knob.x + 140 * (1 - progress), knob.y + 110 * (1 - progress))
          cursor.style.opacity = "1"
        } else if (current.cursorOnly === "out") {
          moveCursor(knob.x + 80 * progress, knob.y + 60 * progress)
          if (progress > 0.3) cursor.style.opacity = "0"
        } else {
          set(current.from + (current.to - current.from) * progress)
          moveCursor(knob.x, knob.y)
        }
        if (progress < 1) return requestAnimationFrame(frame)
        leg += 1
        legStart = 0
        if (leg < legs.length) requestAnimationFrame(frame)
      }
      window.setTimeout(() => requestAnimationFrame(frame), 400)
    }

    new IntersectionObserver(
      ([entry], observer) => {
        if (!entry.isIntersecting) return
        observer.disconnect()
        sweep()
      },
      { threshold: 0.6 }
    ).observe(compare)
  }
</script>
