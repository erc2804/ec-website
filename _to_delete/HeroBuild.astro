---
// --- The heading is built in front of the reader: it starts as the grey
// wireframe of the process scenes, beside it a small code panel types the
// component call with the heading's real text, and the wireframe gives way
// to the heading. Design becomes code becomes the page, in three seconds.
// Decoration for sighted readers, hidden from assistive technology; the
// heading inside stays real and is there from the start for everyone who
// does not see the picture. Under reduced motion only the final state is
// shown. Pure CSS, nothing to measure.
interface Props {
  /** --- The heading's text, repeated in the code panel --- */
  title: string
  class?: string
}

const { title, class: additionalClasses } = Astro.props
---

<span class:list={["ec-build relative block w-fit", additionalClasses]}>
  <span class="ec-build-content block">
    <slot />
  </span>

  <!-- --- The wireframe over the heading: two bars where the two lines are -->
  <span class="ec-build-frame text-display pointer-events-none absolute inset-0" aria-hidden="true">
    <span class="ec-build-bar" style="--ec-bar-width: 92%"></span>
    <span class="ec-build-bar" style="--ec-bar-width: 58%"></span>
  </span>

  <!-- --- The code panel: the component call, typed -->
  <span class="ec-build-code pointer-events-none" aria-hidden="true">
    <span class="ec-build-typed"
      ><span class="ec-build-tag">&lt;</span><span class="ec-build-name">Hero</span>{" "}
      <span class="ec-build-attribute">title</span>=<span class="ec-build-string">"{title}"</span>{" "}
      <span class="ec-build-tag">/&gt;</span></span
    ><span class="ec-build-caret"></span>
  </span>
</span>

<style>
  /* --- The timeline, from the moment the block's rise has settled: the
     panel opens, the call is typed, the wireframe gives way --- */
  .ec-build {
    --ec-panel: 700ms;
    --ec-type: 1000ms;
    --ec-type-duration: 1500ms;
    --ec-build: calc(var(--ec-type) + var(--ec-type-duration) + 350ms);
  }

  /* --- The heading: there, but invisible until it is built --- */
  .ec-build-content {
    opacity: 0;
    translate: 0 0.25rem;
    animation: ec-build-in 500ms cubic-bezier(0.2, 0.8, 0.2, 1) var(--ec-build) forwards;
  }

  .ec-build-frame {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    border-radius: 1rem;
    background: var(--color-gray-subtle);
    outline: 1px solid var(--color-gray-low);
    padding-inline: 0.375em;
    animation: ec-build-out 400ms ease var(--ec-build) forwards;
  }

  .ec-build-bar {
    display: block;
    width: var(--ec-bar-width);
    height: 0.55em;
    border-radius: 999px;
    background: var(--color-gray-low);
  }

  .ec-build-code {
    display: block;
    width: fit-content;
    max-width: 100%;
    overflow: hidden;
    margin-top: 1.5rem;
    border-radius: 0.75rem;
    background: #1f1d1b;
    padding: 0.75rem 1rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    line-height: 1.6;
    white-space: nowrap;
    color: #e8e2d6;
    box-shadow: 0 8px 24px rgb(5 56 107 / 0.12);
    opacity: 0;
    translate: 0 0.5rem;
    animation: ec-build-in 400ms cubic-bezier(0.2, 0.8, 0.2, 1) var(--ec-panel) forwards;
  }

  /* --- Beside the heading where there is room, below it otherwise --- */
  @media (width >= 64rem) {
    .ec-build-code {
      position: absolute;
      top: 0.25rem;
      left: calc(100% + 3rem);
      margin-top: 0;
      max-width: none;
      font-size: 0.8125rem;
    }
  }

  .ec-build-tag {
    color: #9aa3ad;
  }

  .ec-build-name {
    color: #7fd1ff;
  }

  .ec-build-attribute {
    color: #9ff0c4;
  }

  .ec-build-string {
    color: #f9d58a;
  }

  /* --- Typing: the text is revealed from the left, character by character,
     with the caret blinking behind it until the call is complete --- */
  .ec-build-typed {
    display: inline;
    clip-path: inset(0 100% 0 0);
    animation: ec-build-type var(--ec-type-duration) steps(48) var(--ec-type) forwards;
  }

  .ec-build-caret {
    display: inline-block;
    width: 1px;
    height: 1em;
    margin-left: 1px;
    vertical-align: -0.15em;
    background: currentColor;
    animation:
      ec-build-blink 900ms steps(2, start) var(--ec-panel) infinite,
      ec-build-out 1ms linear var(--ec-build) forwards;
  }

  @keyframes ec-build-in {
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @keyframes ec-build-out {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  @keyframes ec-build-type {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes ec-build-blink {
    to {
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ec-build-content,
    .ec-build-code {
      opacity: 1;
      translate: 0 0;
      animation: none;
    }

    .ec-build-frame,
    .ec-build-caret {
      display: none;
    }

    .ec-build-typed {
      clip-path: none;
      animation: none;
    }
  }
</style>
