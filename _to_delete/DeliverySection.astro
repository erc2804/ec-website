---
// --- How a change reaches the client: one pull request card in a generic
// look (no provider named), beside three short points that carry the way of
// working. The change on the card is the one the terminal in the hero asked
// for, so the hero and this section tell one story. The card is text, so it
// stays readable for assistive technology; only the icons are decorative.
//
// One motion: when the card has scrolled fully into view, its status goes
// from open to merged, same duration and curve as the scenes. Without script
// and under prefers-reduced-motion the card is merged from the start.
import { IconCircleCheck, IconExternalLink, IconGitMerge, IconUser } from "@tabler/icons-astro"
import Section from "../../components/ui/Section.astro"
import { useTranslations } from "../../i18n"

const t = useTranslations(Astro.currentLocale).development.delivery
---

<Section tone="light" aria-labelledby="deliveryTitle">
  <h2 id="deliveryTitle" class="ec-reveal text-heading-1 text-balance">{t.title}</h2>
  <p class="mt-5 max-w-[56ch] ec-reveal text-lead text-typo-medium ec-reveal-late">{t.lead}</p>

  <div class="mt-12 grid items-start gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:gap-16">
    <div class="ec-pull-request ec-reveal rounded-3xl bg-gray-subtle p-6 ec-reveal-late md:p-8">
      <!-- --- Branches and status -->
      <p class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-typo-medium">
        <span class="flex items-center gap-2">
          <code class="rounded-md bg-gray-min px-2 py-0.5 font-mono text-xs text-typo-high"
            >{t.card.branch}</code
          >
          <span aria-hidden="true">→</span>
          <code class="rounded-md bg-gray-min px-2 py-0.5 font-mono text-xs text-typo-high"
            >{t.card.target}</code
          >
        </span>
        <span class="ec-pull-request-status ml-auto grid">
          <span class="ec-pull-request-open" aria-hidden="true">{t.card.statusOpen}</span>
          <span class="ec-pull-request-merged">
            <IconGitMerge class="size-4" aria-hidden="true" />
            {t.card.statusMerged}
          </span>
        </span>
      </p>

      <p class="mt-5 text-lead text-typo-high">{t.card.title}</p>
      <p class="mt-2 text-typo-medium">{t.card.body}</p>

      <!-- --- Checks and preview -->
      <ul
        role="list"
        class="mt-6 grid grid-cols-[repeat(auto-fit,minmax(9rem,1fr))] gap-x-6 gap-y-2 border-t border-gray-low pt-5 text-sm"
      >
        {
          t.card.checks.map((check) => (
            <li class="flex items-center gap-2 text-typo-high">
              <IconCircleCheck class="size-4.5 shrink-0 text-brand-green-high" aria-hidden="true" />
              {check}
            </li>
          ))
        }
        <li class="col-span-full flex items-center gap-2 text-typo-medium">
          <IconExternalLink class="size-4.5 shrink-0" aria-hidden="true" />
          {t.card.preview}
        </li>
      </ul>

      <!-- --- Approval -->
      <p
        class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-gray-low pt-5 text-sm text-typo-medium"
      >
        <span class="flex items-center gap-3">
          <span
            class="grid size-7 shrink-0 place-items-center rounded-full bg-gray-min"
            aria-hidden="true"
          >
            <IconUser class="size-4" />
          </span>
          <span>
            <span class="text-typo-high">{t.card.reviewer}</span>
            {" "}
            {t.card.approved}
          </span>
        </span>
        <span class="ml-auto font-mono text-xs whitespace-nowrap">
          <span class="text-brand-green-high">+12</span>
          {" "}
          <span class="text-typo-medium">−9</span>
          {" · "}
          {t.card.files}
        </span>
      </p>
    </div>

    <ul role="list" class="divide-y divide-gray-low border-y border-gray-low lg:border-t-0">
      {
        t.points.map((point, index) => (
          <li
            class="ec-reveal py-6 first:lg:pt-0"
            style={`--ec-reveal-delay: ${110 + index * 110}ms`}
          >
            <h3 class="text-heading-2">{point.title}</h3>
            <p class="mt-2 max-w-[42ch] text-typo-medium">{point.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<style>
  /* --- The two status pills sit on top of each other; the open one fades out
     and the merged one in once the card is in view. Without script there is no
     open state to show, so the merged pill is simply there. --- */
  .ec-pull-request-open,
  .ec-pull-request-merged {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    justify-self: end;
    border-radius: 9999px;
    padding: 0.25rem 0.75rem;
    font-size: 0.8125rem;
    line-height: 1.25rem;
    transition: opacity 600ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  .ec-pull-request-open {
    background: var(--color-gray-low);
    color: var(--color-typo-high);
    opacity: 0;
  }

  .ec-pull-request-merged {
    background: var(--color-brand-green-low);
    color: var(--color-brand-blue);
  }

  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .ec-pull-request:not([data-is-merged="true"]) .ec-pull-request-open {
      opacity: 1;
    }

    .ec-pull-request:not([data-is-merged="true"]) .ec-pull-request-merged {
      opacity: 0;
    }
  }
</style>

<script>
  // --- Merge once half the card is in view (a whole card can be taller than a
  // phone screen), after a beat so the reader has seen it open. Reduced motion never shows the open state (see the CSS), so
  // the attribute is harmless there.
  for (const card of document.querySelectorAll<HTMLElement>(".ec-pull-request")) {
    new IntersectionObserver(
      ([entry], observer) => {
        if (!entry.isIntersecting) return
        observer.disconnect()
        window.setTimeout(() => {
          card.dataset.isMerged = "true"
        }, 900)
      },
      { threshold: 0.5 }
    ).observe(card)
  }
</script>
