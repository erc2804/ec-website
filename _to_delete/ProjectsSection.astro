---
// --- Three recent projects as the page's proof, the way the design page proves
// with the slider and the accessibility page with the demo. One row per
// project, separated by a thin line: on the left when, for whom and what the
// product is, on the right what was hard and what I decided. The decision
// carries the green bar, because that is the part I bring. No images: two of
// the three clients are unnamed, and the list of what was decided is the point.
import Section from "../../components/ui/Section.astro"
import { useTranslations } from "../../i18n"

const t = useTranslations(Astro.currentLocale).development.projects
---

<Section tone="light" aria-labelledby="projectsTitle">
  <h2 id="projectsTitle" class="ec-reveal text-heading-1 text-balance">{t.title}</h2>
  <p class="mt-5 max-w-[56ch] ec-reveal text-lead text-typo-medium ec-reveal-late">{t.lead}</p>

  <ul role="list" class="mt-12 divide-y divide-gray-low border-y border-gray-low">
    {
      t.items.map((project, index) => (
        <li
          class="grid ec-reveal gap-x-16 gap-y-6 py-10 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:py-12"
          style={`--ec-reveal-delay: ${index * 110}ms`}
        >
          <div>
            <p class="text-sm text-typo-medium">
              {project.period}
              <span
                class="mx-2 inline-block size-1 rounded-full bg-current align-middle"
                aria-hidden="true"
              />
              {project.client}
            </p>
            <h3 class="mt-2 text-heading-2 text-balance">{project.title}</h3>
            <p class="mt-3 text-typo-medium">{project.product}</p>
            <p class="mt-4 text-sm text-typo-medium">{project.stack}</p>
          </div>

          <dl class="grid gap-x-10 gap-y-6 self-start md:grid-cols-2">
            <div>
              <dt class="text-sm text-typo-high">{t.hardLabel}</dt>
              <dd class="mt-2 text-typo-medium">{project.hard}</dd>
            </div>
            <div class="border-l-3 border-brand-green-medium pl-4">
              <dt class="text-sm text-typo-high">{t.decisionLabel}</dt>
              <dd class="mt-2 text-typo-high">{project.decision}</dd>
            </div>
          </dl>
        </li>
      ))
    }
  </ul>
</Section>
