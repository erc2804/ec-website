---
// --- What the studies on AI-written code show, and what I do about each
// point: three findings, each with the figure put into words, my answer
// marked with the green bar, and the source as a link. Not interactive on
// purpose; the figures are the point.
import Section from "../../components/ui/Section.astro"
import { useTranslations } from "../../i18n"

const t = useTranslations(Astro.currentLocale).development.findings
---

<Section tone="light" aria-labelledby="findingsTitle">
  <h2 id="findingsTitle" class="ec-reveal text-heading-1 text-balance">{t.title}</h2>
  <p class="mt-5 max-w-[56ch] ec-reveal text-lead text-typo-medium ec-reveal-late">{t.lead}</p>

  <ul role="list" class="mt-12 grid gap-6 lg:grid-cols-3">
    {
      t.items.map((item, index) => (
        <li
          class="flex ec-reveal flex-col gap-4 rounded-3xl bg-gray-subtle p-6 md:p-8"
          style={`--ec-reveal-delay: ${index * 110}ms`}
        >
          <h3 class="text-heading-2 text-balance">{item.title}</h3>
          <p class="text-typo-medium">{item.text}</p>
          <p class="border-l-3 border-brand-green-medium pl-4 text-typo-high">{item.me}</p>
          <p class="mt-auto text-sm text-typo-medium">
            <a href={item.href} target="_blank" rel="noopener noreferrer">
              {t.sourceLabel}
            </a>
            : {item.source}
          </p>
        </li>
      ))
    }
  </ul>
</Section>
