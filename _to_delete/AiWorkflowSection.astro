---
// --- The difference to vibe coding, step by step: the same moment of the
// work, once as vibe coding goes and once as I work. On wider screens a real
// table, my column tinted; on phones the same rows one under the other, the
// table hidden, so nothing is read twice. The dot markers are the ones of the
// design page's states demo: an empty ring for the usual way, a filled dot for
// mine. Under the table the sources the vibe coding side is taken from.
import InlineText from "../../components/ui/InlineText.astro"
import Section from "../../components/ui/Section.astro"
import { useTranslations } from "../../i18n"

const t = useTranslations(Astro.currentLocale).development.aiWorkflow
---

<Section>
  <h2 class="ec-reveal text-heading-1 text-balance">{t.title}</h2>
  <p class="mt-5 max-w-[52ch] ec-reveal text-lead text-typo-medium ec-reveal-late">{t.lead}</p>

  <div class="mt-12 ec-reveal rounded-3xl bg-gray-min p-4 shadow-sm md:p-6">
    <table class="hidden w-full border-separate border-spacing-0 text-left md:table">
      <thead>
        <tr>
          <th scope="col" class="w-[22%] px-5 pt-5 pb-3"
            ><span class="sr-only">{t.momentLabel}</span></th
          >
          <th scope="col" class="w-[36%] px-5 pt-5 pb-3 font-bold text-typo-high">
            <span class="flex items-center gap-2.5">
              <span class="size-2.5 rounded-full border-2 border-typo-medium" aria-hidden="true"
              ></span>
              {t.usualLabel}
            </span>
          </th>
          <th
            scope="col"
            class="rounded-t-2xl bg-brand-green-low/50 px-5 pt-5 pb-3 font-bold text-typo-high"
          >
            <span class="flex items-center gap-2.5">
              <span class="size-2.5 rounded-full bg-brand-green-high" aria-hidden="true"></span>
              {t.mineLabel}
            </span>
          </th>
        </tr>
      </thead>
      <tbody>
        {
          t.rows.map((row, index) => (
            <tr>
              <th scope="row" class="px-5 py-4 align-top font-bold text-typo-high">
                {row.moment}
              </th>
              <td class="px-5 py-4 align-top text-typo-medium">{row.usual}</td>
              <td
                class:list={[
                  "bg-brand-green-low/50 px-5 py-4 align-top text-typo-high",
                  index === t.rows.length - 1 && "rounded-b-2xl pb-6",
                ]}
              >
                {row.mine}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <ul role="list" class="grid gap-3 md:hidden">
      {
        t.rows.map((row) => (
          <li class="p-3">
            <h3 class="font-bold text-typo-high">{row.moment}</h3>
            <p class="mt-3 flex gap-2.5 text-typo-medium">
              <span
                class="mt-2 size-2.5 shrink-0 rounded-full border-2 border-typo-medium"
                aria-hidden="true"
              />
              <span>
                <span class="sr-only">{t.usualLabel}: </span>
                {row.usual}
              </span>
            </p>
            <p class="-mx-3 mt-2 flex gap-2.5 rounded-xl bg-brand-green-low/50 p-3 text-typo-high">
              <span
                class="mt-2 size-2.5 shrink-0 rounded-full bg-brand-green-high"
                aria-hidden="true"
              />
              <span>
                <span class="sr-only">{t.mineLabel}: </span>
                {row.mine}
              </span>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
  <p class="mt-6 max-w-[72ch] ec-reveal text-sm text-typo-medium">
    <InlineText text={t.sources} />
  </p>
</Section>
