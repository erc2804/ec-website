---
import { IconArrowRight, IconChevronRight, IconExternalLink } from "@tabler/icons-astro"
import ContactSection from "../../components/ContactSection.astro"
import MouseChatBubble from "../../components/MouseChatBubble.astro"
import RoleScene from "../../components/RoleScene.astro"
import Button from "../../components/ui/Button.astro"
import ProjectCard from "../../components/ui/ProjectCard.astro"
import { offerSurfaceClasses } from "../../components/ui/offerSurfaceClasses"
import Quote from "../../components/ui/Quote.astro"
import ScrollCue from "../../components/ui/ScrollCue.astro"
import Section from "../../components/ui/Section.astro"
import { siteConfig } from "../../config/site"
import { featuredProjects, localised } from "../../data/projects"
import { localisedPath, useTranslations, type Locale, inquiryPath } from "../../i18n"

const currentLocale = (Astro.currentLocale ?? siteConfig.defaultLocale) as Locale
const t = useTranslations(currentLocale)
const tHome = t.home
const tBubble = t.chatBubble

const linkedInUrl = siteConfig.profiles.find((profile) => profile.platform === "linkedin")!.url

const offerKeys = ["accessibility", "design", "development"] as const

// --- Each offer surface quotes the tool of its subject instead of showing a
// pictogram: an icon-only button that still announces its name, a selection frame
// with measurements on a canvas grid (the frame alone is centred, the size
// label hangs under it without pushing it up), a diff that swaps a magic number for a
// design token. The surface colours are shared with the project cards. All of
// it is decoration: the card text says the same in words.
---

<main id="main">
  <!-- --- Hero: three quarters of the viewport, so the page visibly goes on.
       The lines rise in on load; on scroll the text drifts up and the photo
       eases in, both driven by the scroll position itself, no script. -->
  <section class="ec-hero relative overflow-hidden bg-gray-min ec-on-dark" data-chat-zone>
    <!-- --- Three layers across the whole section: white ground, the cut-out
         portrait anchored to the right edge of the screen, the dark overlay on
         top. Only the text sits in a centred frame of at most 1920px. -->
    <div class="relative mx-auto min-h-[min(78svh,56rem)] w-full max-w-[120rem]">
      <div
        class="ec-hero-content relative z-30 flex min-h-[min(78svh,56rem)] flex-col justify-center gap-8 px-6 pt-header pb-24 md:px-14 xl:px-32 2xl:px-52"
      >
        <!-- --- The dot between the two parts is drawn, not typed: a typed one
             gets read out or swallowed by a screen reader. A hidden comma gives
             the spoken version its pause. -->
        <p class="ec-optical-left ec-rise text-sm tracking-[0.12em] text-brand-sand/70 uppercase">
          <span>{tHome.hero.eyebrow[0]}</span>
          <span
            class="mx-2 inline-block size-1 -translate-px rounded-full bg-current align-middle"
            aria-hidden="true"></span>
          <span class="sr-only">,</span>
          <span>{tHome.hero.eyebrow[1]}</span>
        </p>

        <h1
          class="ec-optical-left ec-rise text-5xl tracking-[0.125rem] uppercase [--ec-rise-delay:120ms] md:text-7xl xl:text-8xl"
        >
          <span class="text-brand-green-medium" data-chat={tBubble.firstName}>Ercan</span>
          {" "}
          <span class="text-brand-sand">Cicek</span>
        </h1>

        <p
          class="ec-optical-left ec-rise text-2xl leading-[1.2] text-brand-sand [--ec-rise-delay:240ms] md:text-4xl"
        >
          {tHome.hero.claim[0]}
          <br />
          {tHome.hero.claim[1]}
        </p>

        <div
          class="w-fit ec-rise [--ec-rise-delay:360ms]"
          data-chat={tBubble.contact}
          data-inquiry-cta
        >
          <Button href={inquiryPath(currentLocale)}>
            {t.common.contactCta}
            <IconArrowRight slot="icon-end" class="size-5" />
          </Button>
        </div>
      </div>

      <ScrollCue
        label={tHome.hero.scrollCue}
        class="absolute bottom-8 left-6 z-30 ec-rise text-brand-sand [--ec-rise-delay:900ms] md:left-14 xl:left-32 2xl:left-52"
      />
    </div>
    <!-- --- Photo at the right edge of the screen, never cropped (contain) -->
    <picture>
      <source media="(min-width: 920px)" srcset="/images/home/hero-landscape.png" />
      <img
        src="/images/home/hero-portrait.png"
        alt=""
        fetchpriority="high"
        class="ec-hero-photo absolute inset-0 z-10 size-full object-contain object-right-bottom min-[920px]:object-right"
      />
    </picture>
    <div class="absolute inset-0 z-20 bg-gray-max/75"></div>
  </section>

  <!-- --- The three offers, each with its own page -->
  <Section data-chat-zone>
    <h2 class="ec-reveal text-heading-1">{tHome.offers.title}</h2>
    <ul role="list" class="mt-10 grid ec-reveal gap-8 ec-reveal-late md:grid-cols-2 lg:grid-cols-3">
      <!-- --- Card pattern from Inclusive Components: the link is the title
           only, so its name stays short and the title is a real heading.
           Its ::after stretches over the whole card for the click target.
           The ring sits on the card, in the card's own shape. -->
      {
        offerKeys.map((key) => (
          <li data-chat={tBubble[key]} class="md:last:odd:col-span-2 lg:last:odd:col-span-1">
            <div class="group relative flex h-full flex-col overflow-hidden rounded-3xl bg-gray-min shadow-sm transition-shadow has-[a:focus-visible]:outline-4 has-[a:focus-visible]:outline-offset-4 has-[a:focus-visible]:outline-brand-green-high lg:hover:shadow-lg">
              <span
                class:list={["grid h-40 place-items-center px-6", offerSurfaceClasses[key]]}
                aria-hidden="true"
                inert
              >
                {key === "accessibility" && (
                  <span class="flex flex-col items-center gap-4">
                    <span class="rounded-lg bg-gray-max/85 px-2.5 py-1 text-xs text-brand-sand">
                      {tHome.offers.vignettes.accessibilityCaption}
                    </span>
                    <span class="grid size-11 place-items-center rounded-full bg-gray-min text-typo-high ring-[3px] ring-gray-high ring-offset-2 ring-offset-brand-green-medium transition-[box-shadow] duration-300 group-has-[a:focus-visible]:ring-offset-4 lg:group-hover:ring-offset-4">
                      <IconChevronRight class="size-5" stroke-width={2.5} />
                    </span>
                  </span>
                )}
                {key === "design" && (
                  <span class="relative">
                    <span class="relative block p-1 outline outline-1 outline-brand-sand">
                      <span class="block h-14 w-32 rounded-xl bg-gray-min/20 transition-[width] duration-300 group-has-[a:focus-visible]:w-40 lg:group-hover:w-40" />
                      <span class="absolute -top-1 -left-1 size-2 border border-brand-sand bg-gray-min" />
                      <span class="absolute -top-1 -right-1 size-2 border border-brand-sand bg-gray-min" />
                      <span class="absolute -bottom-1 -left-1 size-2 border border-brand-sand bg-gray-min" />
                      <span class="absolute -right-1 -bottom-1 size-2 border border-brand-sand bg-gray-min" />
                    </span>
                    <span class="absolute top-full left-1/2 mt-3 grid -translate-x-1/2 rounded bg-brand-sand px-1.5 py-0.5 text-xs font-bold whitespace-nowrap text-gray-high">
                      <span class="col-start-1 row-start-1 transition-opacity duration-300 group-has-[a:focus-visible]:opacity-0 lg:group-hover:opacity-0">
                        {tHome.offers.vignettes.designSizeBefore}
                      </span>
                      <span class="col-start-1 row-start-1 opacity-0 transition-opacity duration-300 group-has-[a:focus-visible]:opacity-100 lg:group-hover:opacity-100">
                        {tHome.offers.vignettes.designSizeAfter}
                      </span>
                    </span>
                  </span>
                )}
                {key === "development" && (
                  <span class="flex w-full max-w-64 flex-col overflow-hidden rounded-xl bg-gray-min py-1 font-mono text-[0.8125rem] leading-7 shadow-sm">
                    <span class="truncate px-3 text-typo-medium line-through opacity-70 transition-opacity duration-300 group-has-[a:focus-visible]:opacity-40 lg:group-hover:opacity-40">
                      - {tHome.offers.vignettes.developmentRemoved}
                    </span>
                    <span class="truncate bg-brand-green-medium/35 px-3 text-typo-high transition-colors duration-300 group-has-[a:focus-visible]:bg-brand-green-medium/60 lg:group-hover:bg-brand-green-medium/60">
                      + {tHome.offers.vignettes.developmentAdded}
                    </span>
                  </span>
                )}
              </span>
              <div class="flex flex-1 flex-col gap-3 p-6 md:p-7">
                <h3 class="text-heading-2 text-brand-green-high">
                  <a
                    href={localisedPath(key, currentLocale)}
                    class="no-underline outline-none after:absolute after:inset-0 after:content-['']"
                  >
                    {tHome.offers.items[key].title}
                  </a>
                </h3>
                <p class="text-typo-medium">{tHome.offers.items[key].teaser}</p>
                <span
                  class="mt-auto flex items-center gap-2 pt-4 font-bold text-typo-medium"
                  aria-hidden="true"
                >
                  {tHome.offers.more}
                  <IconArrowRight class="size-5 transition-[transform,color] group-hover:translate-x-1 group-hover:text-brand-green-high group-has-[a:focus-visible]:translate-x-1 group-has-[a:focus-visible]:text-brand-green-high" />
                </span>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- --- The roles. The cards above say what I do; this says in which role
       someone can bring me in, across all three fields. Told with a small
       scene (RoleScene) that changes with the role.

       Desktop: one scene that travels down the left column and settles next to
       the role being read, changing into it as it arrives. Below lg: every role carries
       its own scene, already in its state, so nothing has to move.

       No chat zone: the scene has its own Ercan. -->
  <Section tone="dark">
    <h2 class="ec-reveal text-display text-balance">{tHome.roles.title}</h2>
    <p class="mt-6 max-w-[52ch] ec-reveal text-lead text-typo-min/85 ec-reveal-late">
      {tHome.roles.lead}
    </p>

    <div class="ec-roles mt-10 grid lg:mt-16 lg:grid-cols-2 lg:gap-16">
      <div class="relative hidden lg:block">
        <RoleScene
          class="ec-roles-scene absolute inset-x-0 top-0 h-[26rem] rounded-3xl bg-typo-min/5 transition-[translate] duration-600 ease-[cubic-bezier(0.65,0,0.35,1)]"
        />
      </div>

      <ol role="list">
        {
          tHome.roles.items.map((role, index) => (
            <li
              class="ec-roles-step flex flex-col gap-3 border-t border-typo-min/20 py-10 transition-colors duration-500 lg:relative lg:min-h-[26rem] lg:justify-center lg:py-12 lg:data-[is-active=true]:border-brand-green-medium"
              data-role={index + 1}
              data-is-active={index === 0 ? "true" : "false"}
            >
              <RoleScene
                role={(index + 1) as 1 | 2 | 3 | 4}
                isCompact
                class="mb-4 h-56 ec-reveal rounded-3xl bg-typo-min/5 lg:hidden"
              />
              <span
                class="text-sm font-bold tracking-[0.12em] text-brand-green-medium"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3 class="text-heading-1">{role.title}</h3>
              <p class="max-w-[46ch] text-lead text-typo-min/85">
                {role.text
                  .split("**")
                  .map((part, partIndex) =>
                    partIndex % 2 === 1 ? (
                      <strong class="rounded-sm bg-brand-green-medium/15 [box-decoration-break:clone] px-1 font-normal text-typo-min">
                        {part}
                      </strong>
                    ) : (
                      part
                    )
                  )}
              </p>
            </li>
          ))
        }
      </ol>
    </div>

    <p class="mt-10 max-w-[60ch] ec-reveal text-lead text-typo-min/85 lg:mt-16">
      {tHome.roles.note}
    </p>
  </Section>

  <!-- --- Endorsements -->
  <Section>
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
      <h2 class="ec-reveal text-heading-1">{tHome.quotes.title}</h2>
      <!-- --- The link says where it goes, the hint under it says what it needs.
           LinkedIn shows recommendations only to signed-in members, so the
           hint is tied to the link as its description: a screen reader reads
           it with the link, before anyone runs into the login wall. -->
      <div class="flex ec-reveal flex-col gap-1 md:items-end">
        <a
          href={`${linkedInUrl}/details/recommendations/`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-bold"
          aria-describedby="quotesLoginHint"
        >
          {tHome.quotes.allLink}
          <IconExternalLink class="size-[1.1em] shrink-0 -translate-y-0.5" aria-hidden="true" />
          <span class="sr-only">{t.common.opensInNewTab}</span>
        </a>
        <p id="quotesLoginHint" class="text-sm text-typo-medium">{tHome.quotes.loginNote}</p>
      </div>
    </div>
    <ul role="list" class="mt-10 grid ec-reveal gap-8 ec-reveal-late md:grid-cols-3">
      {
        tHome.quotes.items.map((quote) => (
          <li>
            <Quote
              name={quote.name}
              role={quote.role}
              annotation={quote.isTranslated ? tHome.quotes.translated : undefined}
            >
              {quote.text}
            </Quote>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- --- Portfolio excerpt -->
  <Section tone="light">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="ec-reveal text-heading-1">{tHome.projects.title}</h2>
      <a href={localisedPath("portfolio", currentLocale)} class="ec-reveal font-bold">
        {tHome.projects.all}
      </a>
    </div>
    <ul
      role="list"
      class="mt-10 grid ec-reveal gap-6 ec-reveal-late sm:grid-cols-2 md:gap-8 lg:grid-cols-3"
    >
      {
        featuredProjects.map((project) => (
          <li>
            <ProjectCard
              href={localisedPath("portfolio", currentLocale, `/${project.slug}`)}
              label={localised(project.label, currentLocale)}
              image={project.image}
              summary={project.summary[currentLocale]}
              mainService={project.services[0]}
              services={project.services.map((service) => t.routeLabels[service])}
            />
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- --- Contact -->
  <ContactSection
    title={tHome.contact.title}
    body={tHome.contact.body}
    data-chat-zone
    data-chat={tBubble.contact}
  />

  <MouseChatBubble />
</main>

<script>
  // --- Desktop roles: the scene travels down to the role being read and
  // settles beside it, changing into it on the way. The active role is the last one
  // whose top has passed the middle of the viewport. Worked out from the
  // positions on every frame of scrolling rather than from intersection
  // events, so it is the same answer in both directions and at any speed.
  //
  // When the change starts is a share of the move: 0 runs both together, 0.7
  // lets the scene arrive first and turn as it lands. Move and change share
  // duration and curve (600ms, see RoleScene), so either reads as one motion.
  const scene = document.querySelector<HTMLElement>(".ec-roles-scene")
  const steps = [...document.querySelectorAll<HTMLElement>(".ec-roles-step")]
  const desktop = window.matchMedia("(width >= 64rem)")
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")
  const moveDuration = 600
  const morphDelayShare = 0
  let activeIndex = -1
  let morphTimeout = 0

  const update = (isInstant = false) => {
    if (!scene || !steps.length || !desktop.matches) return

    const centre = window.innerHeight / 2
    let index = 0
    steps.forEach((step, stepIndex) => {
      if (step.getBoundingClientRect().top <= centre) index = stepIndex
    })
    if (index === activeIndex && !isInstant) return

    activeIndex = index
    for (const [stepIndex, step] of steps.entries()) {
      step.dataset.isActive = stepIndex === index ? "true" : "false"
    }

    const offset = steps[index].getBoundingClientRect().top - steps[0].getBoundingClientRect().top
    const role = steps[index].dataset.role ?? "1"
    window.clearTimeout(morphTimeout)

    if (isInstant) {
      // --- No travel on load and after a resize: the scene just is there
      scene.style.transition = "none"
      scene.style.translate = `0 ${offset}px`
      scene.dataset.role = role
      void scene.offsetHeight
      scene.style.transition = ""
      return
    }

    scene.style.translate = `0 ${offset}px`
    // --- Under reduced motion the move is instant, so there is nothing to wait for
    const delay = reducedMotion.matches ? 0 : moveDuration * morphDelayShare
    morphTimeout = window.setTimeout(() => {
      scene.dataset.role = role
    }, delay)
  }

  let isFramePending = false
  const requestUpdate = () => {
    if (isFramePending) return
    isFramePending = true
    requestAnimationFrame(() => {
      isFramePending = false
      update()
    })
  }

  update(true)
  window.addEventListener("scroll", requestUpdate, { passive: true })
  // --- Sizes change with the layout, so the position is measured afresh
  window.addEventListener("resize", () => update(true), { passive: true })
</script>

<style>
  /* --- Desktop: a dot in the left column where the scene will land next to
     each role, in the scene's own colour, so the column is never empty. The
     scene is translucent and would show the dot through, so the dot of the
     active role fades out while the scene sits on it. --- */
  @media (width >= 64rem) {
    .ec-roles-step::before {
      content: "";
      position: absolute;
      top: 13rem;
      left: calc(-50% - 4rem);
      width: 0.625rem;
      height: 0.625rem;
      translate: -50% -50%;
      border-radius: 50%;
      background: --alpha(var(--color-typo-min) / 10%);
      transition: opacity 500ms;
    }

    .ec-roles-step[data-is-active="true"]::before {
      opacity: 0;
    }
  }

  /* --- The dotted canvas of a design tool, behind the selection frame --- */
  .ec-canvas-grid {
    background-image: radial-gradient(circle, rgb(237 245 225 / 0.45) 1px, transparent 1.5px);
    background-size: 1rem 1rem;
    background-position: center;
  }

  /* --- Scroll-driven exit: progress follows the hero leaving the viewport,
     so it is exactly as fast as the reader scrolls. Browsers without scroll
     timelines simply get the static hero. --- */
  @keyframes ec-hero-content-exit {
    to {
      opacity: 0;
      transform: translateY(-3rem);
    }
  }

  @keyframes ec-hero-photo-exit {
    to {
      transform: scale(1.06);
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .ec-hero {
        view-timeline-name: --ec-hero;
      }

      .ec-hero-content {
        animation: ec-hero-content-exit linear both;
        animation-timeline: --ec-hero;
        animation-range: exit 0% exit 70%;
      }

      .ec-hero-photo {
        animation: ec-hero-photo-exit linear both;
        animation-timeline: --ec-hero;
        animation-range: exit 0% exit 100%;
      }
    }
  }
</style>
