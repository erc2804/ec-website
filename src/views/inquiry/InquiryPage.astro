---
// --- The project request. One form, two ways into it: fill it in directly, or
// write freely and let Pixel-Ercan put it into the fields. Nothing reaches Ercan
// until the visitor presses send. Without JavaScript the chat is not rendered
// and the form posts straight to Netlify Forms.
import {
  IconAlertCircle,
  IconArrowRight,
  IconBrandLinkedin,
  IconCheck,
  IconClipboardCheck,
  IconMail,
  IconMailOpened,
} from "@tabler/icons-astro"
import AssistantChat from "../../components/AssistantChat.astro"
import Button from "../../components/ui/Button.astro"
import ContactCard from "../../components/ui/ContactCard.astro"
import { fieldClasses } from "../../components/ui/fieldClasses"
import { siteConfig } from "../../config/site"
import { topicKeys } from "../../data/inquiry"
import { localisedPath, useTranslations, type Locale } from "../../i18n"

const currentLocale = (Astro.currentLocale ?? siteConfig.defaultLocale) as Locale
const t = useTranslations(currentLocale).inquiry
const tCommon = useTranslations(currentLocale).common

const offerKeys = ["accessibility", "design", "development"] as const
// --- One per step in "Was danach passiert": reading, then the assessment
const stepIcons = [IconMailOpened, IconClipboardCheck]
const linkedInUrl = siteConfig.profiles.find((profile) => profile.platform === "linkedin")!.url

// --- Netlify Forms reads the form from the built HTML; the name ties the
// submissions to it. The success page is the target without scripting.
const formName = "projekt-anfrage"

// --- Strings the script needs, handed over once
const scriptText = {
  assistant: t.assistant,
  form: t.form,
  sent: t.sent,
  email: siteConfig.contact.email,
}

const labelClasses = "flex flex-wrap items-center gap-x-2.5 gap-y-1 font-bold"
const optionalClasses = "font-normal text-typo-medium"
const hintClasses = "text-sm text-typo-medium"
const errorClasses = "ec-field-error hidden text-sm font-bold text-status-error-text"

const inputClasses = [
  "block w-full px-4 py-3",
  fieldClasses,
  "aria-[invalid=true]:border-status-error-text in-data-[is-ai-filled=true]:border-brand-green-high in-data-[is-ai-filled=true]:bg-brand-sand",
].join(" ")

// --- Shown next to a label while Pixel-Ercan's value stands. Hidden from the
// name, since the field is still the same field: the script adds it to the
// field's description instead, which is where a state belongs.
const aiTagClasses =
  "ec-ai-tag hidden items-center rounded-full bg-brand-green-low/60 px-2 py-0.5 text-xs font-bold whitespace-nowrap text-brand-blue in-data-[is-ai-filled=true]:inline-flex"
---

<main
  id="main"
  class="ec-inquiry"
  data-text={JSON.stringify(scriptText)}
  data-locale={currentLocale}
>
  <section
    class="ec-layout-visual-content pt-[calc(var(--spacing-header)+3.5rem)] pb-12 md:pt-[calc(var(--spacing-header)+5.5rem)] md:pb-18"
  >
    <h1 class="max-w-[18ch] ec-rise text-display text-balance">{t.title}</h1>
    <p class="mt-6 max-w-[54ch] ec-rise text-lead text-typo-medium [--ec-rise-delay:120ms]">
      {t.lead}
    </p>
  </section>

  <div
    class="ec-layout-visual-content grid items-start gap-10 pb-20 md:pb-28 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] lg:gap-14"
  >
    <!-- --- Pixel-Ercan, in the chat look of the previous site -->
    <AssistantChat
      text={t.assistant}
      class="ec-rise [--ec-rise-delay:220ms] lg:sticky lg:top-[calc(var(--spacing-header)+1rem)] lg:pt-8"
    >
      <div slot="choices" class="ec-assistant-choices hidden flex-wrap justify-end gap-2">
        <button type="button" class="ec-choice" data-choice="yes">
          <span class="block translate-y-px">{t.assistant.callbackYes}</span>
        </button>
        <button type="button" class="ec-choice" data-choice="no">
          <span class="block translate-y-px">{t.assistant.callbackNo}</span>
        </button>
      </div>
    </AssistantChat>

    <section
      class="ec-request ec-rise rounded-3xl bg-gray-min p-5 shadow-sm [--ec-rise-delay:300ms] md:p-8 data-[is-sent=true]:lg:col-span-2"
    >
      <div class="ec-request-body">
        <h2 id="requestTitle" class="text-heading-2 outline-none" tabindex="-1">{t.form.title}</h2>

        <div
          class="ec-error-summary mt-6 hidden rounded-2xl bg-status-error-bg p-4 text-status-error-text"
          tabindex="-1"
        >
          <p class="flex items-start gap-2 font-bold">
            <IconAlertCircle class="mt-0.5 size-5 shrink-0" aria-hidden="true" />
            {t.form.errorSummary}
          </p>
          <!-- --- The dots are drawn by the script's items, not list markers: a
               screen reader would read the marker out before every error -->
          <ul role="list" class="mt-2 flex flex-col gap-1"></ul>
        </div>

        <form
          name={formName}
          method="POST"
          action={localisedPath("inquirySent", currentLocale)}
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="ec-request-form mt-6 flex flex-col gap-7"
        >
          <input type="hidden" name="form-name" value={formName} />
          <input type="hidden" name="sprache" value={currentLocale} />
          <input type="hidden" name="ki-hilfe" value="nein" />

          <p class="hidden">
            <label>
              {t.form.honeypotLabel}
              <input name="bot-field" tabindex="-1" autocomplete="off" />
            </label>
          </p>

          <fieldset data-field="topics" aria-describedby="topicsHint">
            <legend class={labelClasses}>
              <span>
                {t.form.topicsLegend}{" "}
                <span class={optionalClasses}>({t.form.optional})</span>
              </span>
              <span id="topicsAiTag" class={aiTagClasses} aria-hidden="true">{t.assistant.tag}</span
              >
            </legend>
            <p id="topicsHint" class:list={[hintClasses, "mt-1"]}>{t.form.topicsHint}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {
                topicKeys.map((key) => (
                  <label class="group inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-full border-2 border-gray-medium px-4 transition-colors select-none hover:border-brand-green-high has-checked:border-brand-green-high has-checked:bg-brand-green-high has-checked:text-gray-min has-focus-visible:outline-4 has-focus-visible:outline-offset-2 has-focus-visible:outline-brand-green-high has-focus-visible:outline-solid">
                    <input
                      type="checkbox"
                      name="thema"
                      value={t.form.topics[key]}
                      data-topic={key}
                      class="sr-only"
                    />
                    <IconCheck
                      class="hidden size-4 shrink-0 group-has-checked:block"
                      aria-hidden="true"
                    />
                    <span class="py-1.75 leading-none">{t.form.topics[key]}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="flex flex-col gap-2" data-field="goal">
            <label for="goal" class={labelClasses}>
              <span>{t.form.goalLabel}</span>
              <span id="goalAiTag" class={aiTagClasses} aria-hidden="true">{t.assistant.tag}</span>
            </label>
            <p id="goalHint" class={hintClasses}>{t.form.goalHint}</p>
            <textarea
              id="goal"
              name="vorhaben"
              rows="5"
              required
              maxlength="4000"
              class:list={[inputClasses, "resize-y"]}
              placeholder={t.form.goalPlaceholder}
              aria-describedby="goalHint goalError"></textarea>
            <p id="goalError" class={errorClasses}></p>
          </div>

          <div class="flex flex-col gap-2" data-field="name">
            <label for="name" class={labelClasses}>
              <span>
                {t.form.nameLabel}{" "}
                <span class={optionalClasses}>({t.form.optional})</span>
              </span>
              <span id="nameAiTag" class={aiTagClasses} aria-hidden="true">{t.assistant.tag}</span>
            </label>
            <input id="name" name="name" autocomplete="name" maxlength="200" class={inputClasses} />
          </div>

          <div class="flex flex-col gap-2" data-field="email">
            <label for="email" class={labelClasses}>
              <span>{t.form.emailLabel}</span>
              <span id="emailAiTag" class={aiTagClasses} aria-hidden="true">{t.assistant.tag}</span>
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              spellcheck="false"
              maxlength="200"
              class={inputClasses}
              placeholder={t.form.emailPlaceholder}
              aria-describedby="emailError"
            />
            <p id="emailError" class={errorClasses}></p>
          </div>

          <div class="flex flex-col gap-2">
            <div class="flex flex-col gap-2" data-field="phone">
              <label for="phone" class={labelClasses}>
                <span>
                  {t.form.phoneLabel}{" "}
                  <span class={optionalClasses}>({t.form.optional})</span>
                </span>
                <span id="phoneAiTag" class={aiTagClasses} aria-hidden="true"
                  >{t.assistant.tag}</span
                >
              </label>
              <input
                id="phone"
                name="telefon"
                type="tel"
                autocomplete="tel"
                maxlength="60"
                class={inputClasses}
                placeholder={t.form.phonePlaceholder}
                aria-describedby="phoneError"
              />
              <p id="phoneError" class={errorClasses}></p>
            </div>

            <div data-field="callback">
              <label
                class="inline-flex min-h-11 cursor-pointer flex-wrap items-center gap-x-3 gap-y-1"
              >
                <input
                  id="callback"
                  type="checkbox"
                  name="rueckruf"
                  value="ja"
                  class="size-5 shrink-0 accent-brand-green-high"
                />
                <span>{t.form.callbackLabel}</span>
                <span id="callbackAiTag" class={aiTagClasses} aria-hidden="true"
                  >{t.assistant.tag}</span
                >
              </label>
            </div>
          </div>

          <div class="flex flex-col items-start gap-3">
            <Button type="submit" class="ec-submit">
              <span class="ec-submit-label">{t.form.submit}</span>
              <IconArrowRight slot="icon-end" class="size-5" />
            </Button>
            <p
              class="ec-submit-status text-sm font-bold text-status-error-text empty:hidden"
              role="status"
            >
            </p>
          </div>
        </form>
      </div>

      <!-- --- Focus lands here after sending; the heading inside says what happened -->
      <div
        class="ec-sent mx-auto hidden max-w-[40rem] py-6 text-center outline-none md:py-10"
        tabindex="-1"
      >
        <img
          src="/images/pixelcan.png"
          alt=""
          width="640"
          height="640"
          class="mx-auto size-20 rounded-full bg-gray-low object-cover"
        />
        <h2 class="ec-sent-title mx-auto mt-6 max-w-[24ch] text-heading-1 text-balance"></h2>
        <p class="mt-4 text-lead text-typo-medium">{t.sent.body}</p>

        <div class="mt-12 text-left">
          <h3 class="text-heading-2">{t.sent.offersTitle}</h3>
          <ul role="list" class="mt-5 flex flex-col gap-3">
            <!-- --- Card pattern from Inclusive Components, as on the start
                 page: the link is the title only, so its name stays short, and
                 its ::after covers the card. The line under it stays plain
                 text, read once after the link. -->
            {
              offerKeys.map((key) => (
                <li data-offer={key}>
                  <div class="group relative flex items-center justify-between gap-4 rounded-2xl border-2 border-gray-low p-5 transition-colors hover:border-brand-green-high has-[a:focus-visible]:outline-4 has-[a:focus-visible]:outline-offset-4 has-[a:focus-visible]:outline-brand-green-high">
                    <span class="flex flex-col gap-1">
                      <a
                        href={localisedPath(key, currentLocale)}
                        class="font-bold text-typo-high no-underline outline-none after:absolute after:inset-0 after:z-10 after:content-['']"
                      >
                        {t.sent.offers[key].title}
                      </a>
                      <span class="text-typo-medium">{t.sent.offers[key].text}</span>
                    </span>
                    <IconArrowRight
                      class="size-5 shrink-0 text-brand-green-high transition-transform group-hover:translate-x-1 group-has-[a:focus-visible]:translate-x-1"
                      aria-hidden="true"
                    />
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <Button type="button" variant="secondary" class="ec-new-request mt-10"
          >{t.sent.newRequest}</Button
        >
      </div>
    </section>
  </div>

  <section class="ec-layout-visual-content pb-20 md:pb-24">
    <h2 class="ec-reveal text-heading-1">{t.next.title}</h2>
    <ul role="list" class="mt-8 grid ec-reveal gap-8 ec-reveal-late md:grid-cols-2 md:gap-12">
      {
        t.next.steps.map((step, index) => {
          const StepIcon = stepIcons[index]
          return (
            <li class="flex items-start gap-4">
              <span
                class="grid size-11 shrink-0 place-items-center rounded-full bg-brand-green-low/60 text-brand-blue"
                aria-hidden="true"
              >
                <StepIcon class="size-6" />
              </span>
              <span class="flex flex-col gap-1.5">
                <span class="text-lead text-typo-high">{step.title}</span>
                <span class="text-typo-medium">{step.text}</span>
              </span>
            </li>
          )
        })
      }
    </ul>
  </section>

  <!-- --- The divider of the previous site: the direct ways below stand apart
       from the request and what follows it -->
  <div class="ec-layout-visual-content">
    <hr class="border-gray-low" />
  </div>

  <section class="ec-layout-visual-content pt-20 pb-24 md:pt-24 md:pb-32">
    <h2 class="ec-reveal text-heading-1">{t.next.directTitle}</h2>
    <!-- --- Side by side only from lg: in two columns at md the tiles are too
         narrow for the email address at the lead size -->
    <div class="mt-8 grid ec-reveal gap-4 ec-reveal-late lg:grid-cols-2 lg:gap-6">
      <ContactCard
        href={`mailto:${siteConfig.contact.email}`}
        label={t.next.email}
        address={siteConfig.contact.email}
        copyText={siteConfig.contact.email}
      >
        <IconMail aria-hidden="true" />
      </ContactCard>
      <ContactCard
        href={linkedInUrl}
        label={t.next.linkedin}
        address={tCommon.linkedinInvite}
        isExternal
      >
        <IconBrandLinkedin aria-hidden="true" />
      </ContactCard>
    </div>
  </section>
</main>

<script>
  import { ChatError, createAssistantChat, postToAssistant } from "../../components/assistantChat"
  import { emailPattern, type FieldKey, type FormState, type TopicKey } from "../../data/inquiry"
  import { fill } from "../../i18n/fill"
  type AssistantResult = {
    fields: Partial<FormState>
    reply: string
    step: string
    askCallback: boolean
    isComplete: boolean
  }

  const root = document.querySelector<HTMLElement>(".ec-inquiry")!
  const text = JSON.parse(root.dataset.text ?? "{}")
  const locale = root.dataset.locale ?? "de"
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")
  const desktop = window.matchMedia("(width >= 64rem)")
  const wait = (milliseconds: number) => new Promise((resolve) => setTimeout(resolve, milliseconds))
  const scrollBehavior = (): ScrollBehavior => (reducedMotion.matches ? "auto" : "smooth")

  // --- The form ---------------------------------------------------------------
  const form = root.querySelector<HTMLFormElement>(".ec-request-form")!
  const goal = form.querySelector<HTMLTextAreaElement>("#goal")!
  const name = form.querySelector<HTMLInputElement>("#name")!
  const email = form.querySelector<HTMLInputElement>("#email")!
  const phone = form.querySelector<HTMLInputElement>("#phone")!
  const callback = form.querySelector<HTMLInputElement>("#callback")!
  const topicInputs = [...form.querySelectorAll<HTMLInputElement>("[data-topic]")]
  const aiHelpInput = form.querySelector<HTMLInputElement>("[name='ki-hilfe']")!
  const errorSummary = root.querySelector<HTMLElement>(".ec-error-summary")!
  const submitButton = root.querySelector<HTMLElement>(".ec-submit")!
  const submitLabel = root.querySelector<HTMLElement>(".ec-submit-label")!
  const submitStatus = root.querySelector<HTMLElement>(".ec-submit-status")!
  const textControls = { goal, name, email, phone } as const

  form.noValidate = true

  // --- A reload starts from an empty form. Browsers would otherwise put the
  // previous values back, without Pixel-Ercan's marks or the chat they came from.
  form.reset()
  aiHelpInput.value = "nein"

  const readState = (): FormState => ({
    topics: topicInputs
      .filter((input) => input.checked)
      .map((input) => input.dataset.topic as TopicKey),
    goal: goal.value.trim(),
    name: name.value.trim(),
    email: email.value.trim(),
    phone: phone.value.trim(),
    callback: callback.checked,
  })

  const writeState = (state: Partial<FormState>) => {
    if (state.topics)
      topicInputs.forEach((input) => {
        input.checked = state.topics!.includes(input.dataset.topic as TopicKey)
      })
    ;(Object.keys(textControls) as (keyof typeof textControls)[]).forEach((key) => {
      if (typeof state[key] === "string") textControls[key].value = state[key]
    })
    if (typeof state.callback === "boolean") callback.checked = state.callback
  }

  // --- Arriving from an offer page: ?thema=barrierefreiheit preselects the topic
  const topicFromUrl = new URLSearchParams(location.search).get("thema") ?? ""
  const topicAliases: Record<string, TopicKey> = {
    barrierefreiheit: "accessibility",
    accessibility: "accessibility",
    design: "design",
    entwicklung: "development",
    development: "development",
  }

  // --- Pixel-Ercan's marks: a field keeps its tag while his value stands. Once
  // the visitor changes it, the tag goes; the value is theirs from then on,
  // until they correct it through the chat again.
  const aiFilled = new Set<FieldKey>()
  // --- Whether the call back is settled: an unticked box alone may only mean
  // nobody has asked yet
  let isCallbackAnswered = false
  // --- What Pixel-Ercan has asked so far, so he asks for more detail only once
  const askedSteps = new Set<string>()
  const fieldWrapper = (key: FieldKey) => form.querySelector<HTMLElement>(`[data-field='${key}']`)!

  const markAiFilled = (key: FieldKey, isAiFilled: boolean) => {
    fieldWrapper(key).dataset.isAiFilled = String(isAiFilled)
    if (isAiFilled) aiFilled.add(key)
    else aiFilled.delete(key)

    // --- The tag joins the field's description, so it is read with it: the
    // group for the topics, the box for the call back, the field otherwise
    const control =
      key === "topics"
        ? form.querySelector<HTMLFieldSetElement>("[data-field='topics']")!
        : key === "callback"
          ? callback
          : textControls[key]
    const ids = (control.getAttribute("aria-describedby") ?? "").split(" ").filter(Boolean)
    const tagId = `${key}AiTag`
    const next = isAiFilled ? [...new Set([...ids, tagId])] : ids.filter((id) => id !== tagId)
    if (next.length) control.setAttribute("aria-describedby", next.join(" "))
    else control.removeAttribute("aria-describedby")
  }

  // --- Errors
  const errorTargets = { goal, email, phone } as const
  type ErrorKey = keyof typeof errorTargets

  const setError = (key: ErrorKey, message = "") => {
    const control = errorTargets[key]
    const element = root.querySelector<HTMLElement>(`#${key}Error`)!
    if (message) control.setAttribute("aria-invalid", "true")
    else control.removeAttribute("aria-invalid")
    element.textContent = message
    element.classList.toggle("hidden", !message)
  }

  const validate = () => {
    const state = readState()
    const errors: [ErrorKey, string][] = []
    if (!state.goal) errors.push(["goal", text.form.errors.goal])
    if (!state.email) errors.push(["email", text.form.errors.email])
    else if (!emailPattern.test(state.email)) errors.push(["email", text.form.errors.emailInvalid])
    if (state.callback && !state.phone) errors.push(["phone", text.form.errors.callbackPhone])

    ;(Object.keys(errorTargets) as ErrorKey[]).forEach((key) => setError(key))
    errors.forEach(([key, message]) => setError(key, message))

    errorSummary.querySelector("ul")!.replaceChildren(
      ...errors.map(([key, message]) => {
        const item = document.createElement("li")
        item.setAttribute(
          "class",
          "flex gap-2.5 before:mt-[0.6em] before:size-1.5 before:shrink-0 before:rounded-full before:bg-current before:content-['']"
        )
        const link = document.createElement("a")
        link.href = `#${errorTargets[key].id}`
        link.textContent = message
        link.addEventListener("click", (event) => {
          event.preventDefault()
          errorTargets[key].focus()
        })
        item.append(link)
        return item
      })
    )
    errorSummary.classList.toggle("hidden", errors.length === 0)
    if (errors.length) errorSummary.focus()
    return errors.length === 0
  }

  // --- Every manual change: the tag goes and a shown error clears
  const fieldOf = (control: Element) =>
    control.closest<HTMLElement>("[data-field]")!.dataset.field as FieldKey

  form.addEventListener("input", (event) => {
    const control = event.target as HTMLElement
    if (!control.closest("[data-field]")) return
    const key = fieldOf(control)
    markAiFilled(key, false)
    if (key === "callback") isCallbackAnswered = true
    if (key in errorTargets && !root.querySelector(`#${key}Error`)!.classList.contains("hidden"))
      setError(key as ErrorKey)
    if (key === "callback" && !callback.checked) setError("phone")
  })

  // --- After sending: the pages of the chosen topics, or all three when none
  // of them was picked, and a way to start a new request
  const request = root.querySelector<HTMLElement>(".ec-request")!
  const sent = root.querySelector<HTMLElement>(".ec-sent")!
  const offerItems = [...sent.querySelectorAll<HTMLElement>("[data-offer]")]

  const showOffers = (topics: TopicKey[]) => {
    const chosen = offerItems.filter((item) => topics.includes(item.dataset.offer as TopicKey))
    const shown = chosen.length ? chosen : offerItems
    offerItems.forEach((item) => item.classList.toggle("hidden", !shown.includes(item)))
  }

  // --- Sending
  let isSending = false

  form.addEventListener("submit", async (event) => {
    event.preventDefault()
    if (isSending) return
    if (chat.isWorking()) {
      submitStatus.textContent = text.form.waitForAssistant
      return
    }
    submitStatus.textContent = ""
    if (!validate()) return

    isSending = true
    submitLabel.textContent = text.form.sending
    // --- On a phone Enter in a field sends too, with the button below the
    // keyboard: it comes into sight, so "Sending" is seen where it happens
    if (!desktop.matches) {
      submitButton.scrollIntoView({ block: "nearest", behavior: scrollBehavior() })
    }
    const data = new FormData(form)
    const topics = data.getAll("thema").join(", ")
    data.delete("thema")
    data.set("thema", topics)

    try {
      const response = await fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
      })
      if (!response.ok) throw new Error(String(response.status))

      const firstName = name.value.trim().split(/\s+/)[0]
      root.querySelector(".ec-sent-title")!.textContent = firstName
        ? fill(text.sent.titleWithName, { name: firstName })
        : text.sent.title
      showOffers(readState().topics)
      request.dataset.isSent = "true"
      root.querySelector(".ec-request-body")!.classList.add("hidden")
      root.querySelector(".ec-assistant")!.classList.add("hidden")
      sent.classList.remove("hidden")
      // --- On a phone the chat above folds away and the page would land
      // somewhere in the middle of the thanks; it starts at its top instead
      if (desktop.matches) {
        sent.focus()
      } else {
        sent.focus({ preventScroll: true })
        scrollToForm()
      }
    } catch {
      submitStatus.textContent = fill(text.form.sendError, { email: text.email })
    } finally {
      isSending = false
      submitLabel.textContent = text.form.submit
    }
  })

  // --- Pixel-Ercan --------------------------------------------------------------
  const assistant = root.querySelector<HTMLElement>(".ec-assistant")!
  const choices = assistant.querySelector<HTMLElement>(".ec-assistant-choices")!

  const scrollToForm = () => request.scrollIntoView({ behavior: scrollBehavior(), block: "start" })

  const setChoicesVisible = (isVisible: boolean) => {
    choices.classList.toggle("hidden", !isVisible)
    choices.classList.toggle("flex", isVisible)
  }

  // --- One quiet line before the reply: what just went into the form. On a
  // phone the form is out of sight below, so it also leads there.
  const filledLine = (keys: string[]) => {
    const line = document.createElement("p")
    line.classList.add("ec-filled")
    const icon = document.createElement("span")
    icon.setAttribute("aria-hidden", "true")
    icon.textContent = "✓"
    const label = document.createElement("span")
    label.textContent = fill(text.assistant.filled, {
      fields: keys.map((key) => text.assistant.fieldNames[key]).join(", "),
    })
    line.append(icon, label)
    if (!desktop.matches) {
      const link = document.createElement("button")
      link.type = "button"
      link.classList.add("ec-filled-link")
      link.textContent = text.assistant.toForm
      link.addEventListener("click", () => {
        scrollToForm()
        root.querySelector<HTMLElement>("#requestTitle")!.focus({ preventScroll: true })
      })
      line.append(link)
    }
    return line
  }

  // --- Typed in rather than set, so the change is visible where it happens.
  // Longer texts type in steps; under reduced motion the value is simply there.
  const typeInto = async (control: HTMLInputElement | HTMLTextAreaElement, value: string) => {
    if (reducedMotion.matches) {
      control.value = value
      return
    }
    const step = Math.max(1, Math.ceil(value.length / 60))
    for (let index = 0; index < value.length; index += step) {
      control.value = value.slice(0, index + step)
      await wait(16)
    }
    control.value = value
  }

  // --- The server only returns fields the latest message adds or changes
  const applyFields = async (fields: Partial<FormState>) => {
    const changed: FieldKey[] = []
    if (fields.topics) {
      writeState({ topics: fields.topics })
      markAiFilled("topics", true)
      changed.push("topics")
    }
    for (const key of Object.keys(textControls) as (keyof typeof textControls)[]) {
      const value = fields[key]
      if (typeof value !== "string") continue
      markAiFilled(key, true)
      if (key in errorTargets) setError(key as ErrorKey)
      await typeInto(textControls[key], value)
      changed.push(key)
    }
    if (typeof fields.callback === "boolean") {
      isCallbackAnswered = true
      callback.checked = fields.callback
      markAiFilled("callback", true)
      changed.push("callback")
      if (!fields.callback) setError("phone")
    }
    return changed
  }

  const chat = createAssistantChat(assistant, {
    onAsk: () => setChoicesVisible(false),
    respond: async (messages) => {
      const result = (await postToAssistant("/api/inquiry-assist", {
        locale,
        messages,
        form: readState(),
        callbackAnswered: isCallbackAnswered,
        askedSteps: [...askedSteps],
      })) as AssistantResult
      if (typeof result?.reply !== "string") throw new ChatError("garbled")
      askedSteps.add(result.step)

      // --- The dots keep going while the fields fill in; then what went in,
      // and his next question last, where the eye ends up
      aiHelpInput.value = "ja"
      const changed = await applyFields(result.fields ?? {})
      return {
        reply: result.reply,
        before: () => {
          if (changed.length) chat.appendLine(filledLine(changed))
        },
        after: async () => {
          setChoicesVisible(result.askCallback)
          // --- Done: on narrow screens the form sits below, out of sight. A
          // moment first, so the last line in the chat is read before the page moves.
          if (result.isComplete && !desktop.matches) {
            await wait(1400)
            scrollToForm()
          }
        },
      }
    },
    // --- Starting over clears the conversation, not the form: what is in the
    // fields stays, it just no longer counts as Pixel-Ercan's
    onReset: () => {
      askedSteps.clear()
      isCallbackAnswered = callback.checked
      ;[...aiFilled].forEach((key) => markAiFilled(key, false))
      setChoicesVisible(false)
    },
  })

  choices.querySelectorAll<HTMLButtonElement>("[data-choice]").forEach((button) =>
    button.addEventListener("click", () => {
      isCallbackAnswered = true
      chat.ask(
        button.dataset.choice === "yes"
          ? text.assistant.callbackYesMessage
          : text.assistant.callbackNoMessage
      )
      chat.focusAfterChoice()
    })
  )

  if (topicAliases[topicFromUrl]) writeState({ topics: [topicAliases[topicFromUrl]] })

  // --- A new request starts from scratch: empty form, fresh chat
  sent.querySelector(".ec-new-request")!.addEventListener("click", () => {
    form.reset()
    aiHelpInput.value = "nein"
    ;[...aiFilled].forEach((key) => markAiFilled(key, false))
    ;(Object.keys(errorTargets) as ErrorKey[]).forEach((key) => setError(key))
    errorSummary.classList.add("hidden")
    submitStatus.textContent = ""
    chat.reset()
    sent.classList.add("hidden")
    request.dataset.isSent = "false"
    root.querySelector(".ec-request-body")!.classList.remove("hidden")
    assistant.classList.remove("hidden")
    chat.refresh()
    request.scrollIntoView({ behavior: scrollBehavior(), block: "start" })
    root.querySelector<HTMLElement>("#requestTitle")!.focus({ preventScroll: true })
  })
</script>

<style>
  /* --- What went into the form: one line between the bubbles, nothing more --- */
  :global(.ec-assistant .ec-filled) {
    padding-inline-start: 3.75rem;
    color: var(--color-typo-medium);
    font-size: 0.875rem;
  }

  :global(.ec-assistant .ec-filled > span:first-child) {
    margin-inline-end: 0.4rem;
    color: var(--color-brand-green-high);
    font-weight: 700;
  }

  :global(.ec-assistant .ec-filled-link) {
    margin-inline-start: 0.5rem;
    min-height: 2.75rem;
    color: var(--color-brand-blue);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
