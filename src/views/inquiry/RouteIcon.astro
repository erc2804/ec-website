---
// --- "You get a clear assessment": a short route, two stops and a flag at
// the end, the way the step reads: what makes sense, what it takes, how we
// start. Drawn on Tabler's 24 grid with its 2px stroke, so it sits well
// beside Tabler icons.
interface Props {
  class?: string
}

const { class: additionalClasses } = Astro.props
---

<svg
  class={additionalClasses}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <circle cx="5" cy="19" r="2"></circle>
  <circle cx="11" cy="13" r="2"></circle>
  <path d="M6.5 17.5l3-3M12.5 11.5l3.5-3.5"></path>
  <path d="M17 11V3h4l-1.5 2 1.5 2h-4"></path>
</svg>
