---
// --- "I read your request personally": a letter with my round glasses
// above it, the ones from the portrait. Drawn on Tabler's 24 grid with its
// 2px stroke, so it sits well beside Tabler icons.
interface Props {
  class?: string
}

const { class: additionalClasses } = Astro.props
---

<svg
  class={additionalClasses}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <rect x="3" y="11" width="18" height="10" rx="2"></rect>
  <path d="M3 13l9 5 9-5"></path>
  <circle cx="8" cy="5.5" r="2.5"></circle>
  <circle cx="16" cy="5.5" r="2.5"></circle>
  <path d="M10.5 5.5h3"></path>
</svg>
