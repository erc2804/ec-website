---
import Placeholder from "../../components/ui/Placeholder.astro"
import Section from "../../components/ui/Section.astro"
---

<main id="main" class="pt-header">
  <Section>
    <h1 class="text-display">Über mich</h1>
    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <Placeholder>
        Kurzfassung des LinkedIn-Info-Textes: Product Engineer, Barrierefreiheit, KI-gestützt. Vier
        kurze Absätze, keine Werkzeugliste im Fließtext.
      </Placeholder>
      <img
        src="/images/ercancicek.jpg"
        alt="Ercan Cicek"
        width="320"
        height="320"
        class="size-40 rounded-full object-cover object-[40%] md:size-64 lg:size-80"
      />
    </div>
    <Placeholder class="mt-10">
      Kontaktkarten (E-Mail, LinkedIn) wie bisher. Der KI-Teil wird später entschieden.
    </Placeholder>
  </Section>
</main>
