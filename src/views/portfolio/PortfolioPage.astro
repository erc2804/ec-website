---
// --- The portfolio: every project as a card, newest first. Below it one row
// of pill links, GitHub, the first portfolio and the playgrounds, and the
// contact block. The cards link to the
// project pages.
import {
  IconBrandCodepen,
  IconBrandGithub,
  IconCode,
  IconDeviceGamepad2,
  IconMovie,
} from "@tabler/icons-astro"
import ContactSection from "../../components/ContactSection.astro"
import ExternalLinkButton from "../../components/ui/ExternalLinkButton.astro"
import ProjectCard from "../../components/ui/ProjectCard.astro"
import Section from "../../components/ui/Section.astro"
import { siteConfig } from "../../config/site"
import { projectMockup } from "../../data/projectMockup"
import { elsewhereLinks, localised, projects } from "../../data/projects"
import { localisedPath, useTranslations, type Locale } from "../../i18n"

const currentLocale = (Astro.currentLocale ?? siteConfig.defaultLocale) as Locale
const t = useTranslations(currentLocale)
const tPortfolio = t.portfolio

const elsewhereIcons = {
  github: IconBrandGithub,
  gamepad: IconDeviceGamepad2,
  code: IconCode,
  codepen: IconBrandCodepen,
  movie: IconMovie,
}
---

<main id="main" class="pt-header">
  <Section>
    <h1 class="ec-rise text-display">{tPortfolio.title}</h1>
    <p class="mt-6 max-w-[52ch] ec-rise text-lead text-typo-medium [--ec-rise-delay:150ms]">
      {tPortfolio.lead}
    </p>

    <ul role="list" class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project, index) => {
          return (
            <li class="ec-reveal" style={`--ec-reveal-delay: ${(index % 4) * 80}ms`}>
              <ProjectCard
                href={localisedPath("portfolio", currentLocale, `/${project.slug}`)}
                label={localised(project.label, currentLocale)}
                image={project.image && projectMockup(project.image.file)}
                summary={project.summary[currentLocale]}
                headingLevel={2}
              />
            </li>
          )
        })
      }
    </ul>
  </Section>

  <Section tone="light">
    <h2 class="ec-reveal text-heading-1">{tPortfolio.elsewhere.title}</h2>
    <p class="mt-5 max-w-[52ch] ec-reveal text-lead text-typo-medium ec-reveal-late">
      {tPortfolio.elsewhere.lead}
    </p>

    <ul role="list" class="mt-8 flex flex-wrap gap-3">
      {
        elsewhereLinks.map((item) => {
          return (
            <li>
              <ExternalLinkButton
                href={item.url}
                label={item.label}
                icon={elsewhereIcons[item.icon]}
              />
            </li>
          )
        })
      }
    </ul>
  </Section>

  <ContactSection title={tPortfolio.contact.title} body={tPortfolio.contact.body} />
</main>
