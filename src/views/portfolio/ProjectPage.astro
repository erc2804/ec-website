---
// --- One project: the client's name as the heading, one line on what it was,
// the story in a few paragraphs and the link to the live product. On the right
// the mockup on the light green panel of the card, and under it the facts as
// a list: when, as what, for whom, which offers, which skills. Not sticky:
// mockup and facts together are taller than a laptop window. The mockup's alt
// text comes with the project.
import { IconArrowLeft, IconWorld } from "@tabler/icons-astro"
import { Picture } from "astro:assets"
import ContactSection from "../../components/ContactSection.astro"
import ExternalLinkButton from "../../components/ui/ExternalLinkButton.astro"
import InlineText from "../../components/ui/InlineText.astro"
import Section from "../../components/ui/Section.astro"
import { siteConfig } from "../../config/site"
import { projectMockup } from "../../data/projectMockup"
import { localised, type Project } from "../../data/projects"
import { localisedPath, useTranslations, type Locale } from "../../i18n"
import { fill } from "../../i18n/fill"

interface Props {
  project: Project
}

const { project } = Astro.props

const currentLocale = (Astro.currentLocale ?? siteConfig.defaultLocale) as Locale
const translations = useTranslations(currentLocale)
const tPortfolio = translations.portfolio
const t = tPortfolio.project

const label = localised(project.label, currentLocale)
const hostname = project.url ? new URL(project.url).hostname.replace(/^www\./, "") : undefined

// --- The facts list. The employer for work in employment, the description of
// the client where the name stays out; a named client is the heading already.
const facts: { term: string; value: string }[] = [
  { term: t.facts.period, value: project.period[currentLocale] },
  { term: t.facts.role, value: project.role[currentLocale] },
  ...(project.employer ? [{ term: t.facts.employer, value: project.employer }] : []),
  ...(project.client ? [{ term: t.facts.client, value: project.client[currentLocale] }] : []),
  {
    term: t.facts.services,
    value: project.services.map((service) => translations.routeLabels[service]).join(", "),
  },
  {
    term: t.facts.skills,
    value: project.techs.map((tech) => localised(tech.label, currentLocale)).join(", "),
  },
]
---

<main id="main" class="pt-header">
  <Section>
    <!-- --- Styled like "More" on the start page's offer cards, the arrow
         pointing back -->
    <a
      href={localisedPath("portfolio", currentLocale)}
      class="group inline-flex min-h-11 items-center gap-2 font-bold text-typo-medium no-underline"
    >
      <IconArrowLeft
        class="size-5 transition-[translate,color] group-hover:-translate-x-1 group-hover:text-brand-green-high group-focus-visible:-translate-x-1 group-focus-visible:text-brand-green-high"
        aria-hidden="true"
      />
      {t.back}
    </a>

    <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] lg:gap-20">
      <div>
        <h1 class="ec-rise text-display text-balance">{label}</h1>
        <p class="mt-4 max-w-[44ch] ec-rise text-lead text-typo-medium [--ec-rise-delay:100ms]">
          {project.title[currentLocale]}
        </p>

        <div class="mt-10 flex max-w-[62ch] ec-rise flex-col gap-5 [--ec-rise-delay:200ms]">
          {
            project.description[currentLocale].map((paragraph) => (
              <p class="text-body text-typo-medium">
                <InlineText text={paragraph} />
              </p>
            ))
          }
        </div>

        {
          project.url && hostname && (
            <div class="mt-10 ec-rise [--ec-rise-delay:250ms]">
              <ExternalLinkButton
                href={project.url}
                label={fill(t.visit, { host: hostname })}
                icon={IconWorld}
              />
            </div>
          )
        }
      </div>

      <div class="ec-rise [--ec-rise-delay:150ms] lg:self-start">
        {
          project.image && (
            <div class="rounded-3xl bg-brand-green-low p-8">
              <Picture
                src={projectMockup(project.image.file)}
                formats={["avif"]}
                fallbackFormat="webp"
                widths={[208, 416, 624]}
                sizes="13rem"
                alt={project.image.alt[currentLocale]}
                class="mx-auto h-auto w-full max-w-[13rem] drop-shadow-xl"
              />
            </div>
          )
        }
        <h2 class="sr-only">{t.facts.title}</h2>
        <dl
          class:list={[
            "divide-y divide-gray-low border-y border-gray-low",
            project.image && "mt-8",
          ]}
        >
          {
            facts.map((fact) => (
              <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-4 py-3 text-sm">
                <dt class="text-typo-medium">{fact.term}</dt>
                <dd class="text-typo-high">
                  <InlineText text={fact.value} />
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </Section>

  <ContactSection title={tPortfolio.contact.title} body={tPortfolio.contact.body} />
</main>
