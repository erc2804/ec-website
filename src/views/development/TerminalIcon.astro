---
// --- Service icon for building something new: the terminal from the
// page's hero, with its prompt and cursor. Drawn on Tabler's 24 grid with
// its 2px stroke, so it sits well beside Tabler icons.
interface Props {
  class?: string
}

const { class: additionalClasses } = Astro.props
---

<svg
  class={additionalClasses}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <rect x="3" y="4" width="18" height="16" rx="2"></rect>
  <path d="M7.5 10l2.5 2-2.5 2"></path>
  <path d="M12.5 15h4"></path>
</svg>
