---
// --- Development offer page. The heading sits in the browser's inspector,
// the way the design page's heading sits in a design tool's selection frame.
// Then how someone can bring me in, why vibe coding alone is not enough (a
// prototype under the developer tools), why a developer at all when AI writes
// the code, the usual questions, and the contact block. No process section here (docs/design-language.md, Motion).
//
// Services, the one-hand block, the questions and the contact block are the
// shared components of the offer pages.
import { IconArrowRight } from "@tabler/icons-astro"
import MergeIcon from "./MergeIcon.astro"
import PrototypeIcon from "./PrototypeIcon.astro"
import TerminalIcon from "./TerminalIcon.astro"
import InspectFrame from "./InspectFrame.astro"
import VibeCodingSection from "./VibeCodingSection.astro"
import ContactSection from "../../components/ContactSection.astro"
import FaqSection from "../../components/FaqSection.astro"
import OneHandSection from "../../components/OneHandSection.astro"
import ServicesSection from "../../components/ServicesSection.astro"
import Button from "../../components/ui/Button.astro"
import { siteConfig } from "../../config/site"
import { inquiryPath, useTranslations, type Locale } from "../../i18n"

const currentLocale = (Astro.currentLocale ?? siteConfig.defaultLocale) as Locale
const t = useTranslations(currentLocale).development
const tCommon = useTranslations(currentLocale).common

// --- One icon per service, in the order of the copy: prototype to product,
// building new, reinforcing the team
// --- Drawn for this page: the prototype becoming the product, the hero's
// terminal, a branch merging into the team's code
const serviceIcons = [PrototypeIcon, TerminalIcon, MergeIcon]
---

<main id="main">
  <!-- --- The hero is the page under the inspector. overflow-x clip, because
       the terminal sits beside the heading. -->
  <section class="overflow-x-clip">
    <div
      class="ec-layout-visual-content pt-[calc(var(--spacing-header)+4rem)] pb-20 md:pt-[calc(var(--spacing-header)+6rem)] md:pb-28"
    >
      <InspectFrame prompt={t.hero.prompt} working={t.hero.working} class="ec-rise">
        <h1 class="max-w-[16ch] text-display text-balance">{t.hero.title}</h1>
      </InspectFrame>
      <p class="mt-10 max-w-[52ch] ec-rise text-lead text-typo-medium [--ec-rise-delay:150ms]">
        {t.hero.lead}
      </p>
      <div class="mt-9 w-fit ec-rise [--ec-rise-delay:250ms]" data-inquiry-cta>
        <Button href={inquiryPath(currentLocale, "development")}>
          {tCommon.contactCta}
          <IconArrowRight slot="icon-end" class="size-5" />
        </Button>
      </div>
    </div>
  </section>

  <ServicesSection
    title={t.services.title}
    lead={t.services.lead}
    items={t.services.items}
    icons={serviceIcons}
    tone="light"
  />

  <VibeCodingSection />

  <OneHandSection
    title={t.oneHand.title}
    body={t.oneHand.body}
    portraitAlt={t.oneHand.portraitAlt}
  />

  <FaqSection title={t.faq.title} items={t.faq.items} />

  <ContactSection title={t.contact.title} body={t.contact.body} topic="development" />
</main>
