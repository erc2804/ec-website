---
import { IconArrowRight } from "@tabler/icons-astro"
import Button from "../../components/ui/Button.astro"
import Placeholder from "../../components/ui/Placeholder.astro"
import Section from "../../components/ui/Section.astro"
import { siteConfig } from "../../config/site"
import { inquiryPath, useTranslations, type Locale } from "../../i18n"

const t = useTranslations(Astro.currentLocale)
const inquiryHref = inquiryPath(
  (Astro.currentLocale ?? siteConfig.defaultLocale) as Locale,
  "design"
)
---

<main id="main" class="pt-header">
  <Section>
    <h1 class="text-display text-balance">Ich gestalte Produkte, die sich von selbst erklären.</h1>
    <p class="mt-8 max-w-[56ch] text-lead text-typo-medium">
      Platzhalter für den Einleitungssatz: UI/UX-Design für Startups und Unternehmen, von der Idee
      bis zur gebauten Oberfläche.
    </p>
    <Button class="mt-9" href={inquiryHref} data-inquiry-cta>
      {t.common.contactCta}
      <IconArrowRight slot="icon-end" class="size-5" />
    </Button>
  </Section>

  <Section tone="light">
    <h2 class="text-heading-1">Demo: KI-Standard gegen eigenes Gesicht</h2>
    <Placeholder class="mt-10">
      Schieberegler. Links derselbe Screen im typischen KI-Look (alle gleich, keine Hierarchie),
      rechts mit Hierarchie und Marke.
    </Placeholder>
  </Section>

  <Section>
    <h2 class="text-heading-1">Was ich mache</h2>
    <Placeholder class="mt-10">
      Designsystem, Figma, Prototyp, und ich bleibe beim Bauen dabei. Drei Sätze.
    </Placeholder>
  </Section>

  <Section tone="light">
    <h2 class="text-heading-1">Für wen</h2>
    <Placeholder class="mt-10">
      Startups mit KI-MVP, Unternehmen mit gewachsenem Produkt, Agenturen mit Bedarf an
      Design-Kapazität.
    </Placeholder>
  </Section>

  <Section>
    <h2 class="text-heading-1">Projekte</h2>
    <Placeholder class="mt-10">Zwei Portfolio-Karten als Beleg (Curanto, Welliba).</Placeholder>
  </Section>

  <Section tone="dark">
    <Placeholder label="Kontakt" class="border-brand-green-medium/60 text-typo-min/85">
      Kontakt-Block, auf allen Angebotsseiten gleich.
    </Placeholder>
  </Section>
</main>
