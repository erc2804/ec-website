---
// --- Design offer page. Its argument is shown, not told, in two demos: the
// before/after with the top of my own home page, once as an AI built it
// and once as I designed it (see the difference), and the states (it holds up
// in real life). The heading sits in
// a design tool's selection frame, the way the accessibility page's heading
// sits next to its VoiceOver caption. Then what I do, why
// design and code from one person, the usual questions.
//
// Services, the one-hand block, the questions and the contact block are shared
// with the accessibility page on purpose: they answer the same questions there.
// The demos are this page's own.
import { IconArrowRight } from "@tabler/icons-astro"
import BeforeAfterIcon from "./BeforeAfterIcon.astro"
import BuildingBlocksIcon from "./BuildingBlocksIcon.astro"
import CompareSideBySide from "./CompareSideBySide.astro"
import SelectionIcon from "./SelectionIcon.astro"
import DesignProcessScene from "./DesignProcessScene.astro"
import StatesDemo from "./StatesDemo.astro"
import ContactSection from "../../components/ContactSection.astro"
import FaqSection from "../../components/FaqSection.astro"
import OneHandSection from "../../components/OneHandSection.astro"
import ProcessSnap from "../../components/ProcessSnap.astro"
import ServicesSection from "../../components/ServicesSection.astro"
import Button from "../../components/ui/Button.astro"
import Section from "../../components/ui/Section.astro"
import SelectionFrame from "../../components/ui/SelectionFrame.astro"
import { siteConfig } from "../../config/site"
import { inquiryPath, useTranslations, type Locale } from "../../i18n"

const currentLocale = (Astro.currentLocale ?? siteConfig.defaultLocale) as Locale
const t = useTranslations(currentLocale).design
const tCommon = useTranslations(currentLocale).common

// --- Drawn for this page, each quoting a piece of it: the selection frame,
// the before and after, the building blocks of a system
const serviceIcons = [SelectionIcon, BeforeAfterIcon, BuildingBlocksIcon]
---

<main id="main">
  <!-- --- The hero is a design tool's canvas: the dot grid of the start page's
       design card, fading out towards the bottom. overflow-x clip, because the
       cursor of the selection frame glides in from outside the page. -->
  <section class="ec-hero-canvas isolate overflow-x-clip">
    <div
      class="ec-layout-visual-content pt-[calc(var(--spacing-header)+4rem)] pb-20 md:pt-[calc(var(--spacing-header)+6rem)] md:pb-28"
    >
      <SelectionFrame
        label={t.hero.selection}
        cursorName={siteConfig.name.split(" ")[0]}
        tokenBefore={t.hero.tokenBefore}
        tokenMiddle={t.hero.tokenMiddle}
        tokenAfter={t.hero.tokenAfter}
        class="ec-rise"
      >
        <h1 class="max-w-[16ch] text-display text-balance">{t.hero.title}</h1>
      </SelectionFrame>
      <p class="mt-10 max-w-[52ch] ec-rise text-lead text-typo-medium [--ec-rise-delay:150ms]">
        {t.hero.lead}
      </p>
      <div class="mt-9 w-fit ec-rise [--ec-rise-delay:250ms]" data-inquiry-cta>
        <Button href={inquiryPath(currentLocale, "design")}>
          {tCommon.contactCta}
          <IconArrowRight slot="icon-end" class="size-5" />
        </Button>
      </div>
    </div>
  </section>

  <!-- --- The core of the work: the argument and the browser window with the
       two pages. The pictures speak for themselves. -->
  <Section tone="light" aria-labelledby="compareTitle">
    <h2 id="compareTitle" class="ec-reveal text-heading-1 text-balance">{t.compare.title}</h2>
    <p class="mt-5 max-w-[56ch] ec-reveal text-lead text-typo-medium ec-reveal-late">
      {t.compare.lead}
    </p>
    <p class="mt-4 max-w-[56ch] ec-reveal text-typo-medium ec-reveal-late">{t.compare.example}</p>

    <CompareSideBySide class="mt-12 ec-reveal ec-reveal-late" />
  </Section>

  <ServicesSection
    title={t.services.title}
    lead={t.services.lead}
    items={t.services.items}
    icons={serviceIcons}
  />

  <StatesDemo />

  <ProcessSnap
    title={t.process.title}
    lead={t.process.lead}
    steps={t.process.steps}
    Scene={DesignProcessScene}
  />

  <OneHandSection
    title={t.oneHand.title}
    body={t.oneHand.body}
    portraitAlt={t.oneHand.portraitAlt}
  />

  <FaqSection title={t.faq.title} items={t.faq.items} />

  <ContactSection title={t.contact.title} body={t.contact.body} topic="design" hasCursor />
</main>

<style>
  /* --- The dotted canvas of a design tool, same dots as the design card on the
     start page, in the page's own blue. On a pseudo-element, so only the dots
     fade before the next section, not the content. --- */
  .ec-hero-canvas {
    position: relative;
  }

  .ec-hero-canvas::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(circle, rgb(5 56 107 / 0.14) 1px, transparent 1.5px);
    background-size: 1.5rem 1.5rem;
    background-position: center top;
    mask-image: linear-gradient(to bottom, black 55%, transparent);
  }
</style>
