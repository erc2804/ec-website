---
// --- Service icon for a design system: three basic building blocks, a
// square, a circle and a pill. Drawn on Tabler's 24 grid with its 2px stroke,
// so it sits well beside Tabler icons.
interface Props {
  class?: string
}

const { class: additionalClasses } = Astro.props
---

<svg
  class={additionalClasses}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
  <circle cx="17.5" cy="6.5" r="3.5"></circle>
  <rect x="3" y="14" width="18" height="7" rx="3.5"></rect>
</svg>
