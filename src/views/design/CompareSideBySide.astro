---
// --- Before and after, side by side: the top of my own home page as an AI
// model built it from the same content (first), and as I designed it
// (second). Each in its own browser window under its name; on phones one under
// the other. Under each name one line on what it comes down to. Name, line and
// window share subgrid rows, so the pictures stay level whatever the line's
// length. The info button next to "AI-generated" opens the dialog with model,
// date and prompt. The pictures carry no alt text of their own; one sentence
// tells screen readers what the comparison shows.
import { IconInfoCircle } from "@tabler/icons-astro"
import Dialog from "../../components/ui/Dialog.astro"
import { useTranslations } from "../../i18n"

interface Props {
  class?: string
}

const { class: additionalClasses } = Astro.props
const t = useTranslations(Astro.currentLocale).design.compare
const locale = Astro.currentLocale === "en" ? "en" : "de"

const pages = [
  {
    key: "ai",
    label: t.before,
    note: t.beforeNote,
    image: `/images/design/compare-ai-${locale}.webp`,
  },
  {
    key: "designed",
    label: t.after,
    note: t.afterNote,
    image: `/images/design/compare-designed-${locale}.webp`,
  },
]
---

<figure
  class:list={["m-0 grid gap-8 md:grid-cols-2 md:gap-x-6 md:gap-y-0", additionalClasses]}
  aria-describedby="compareDescription"
>
  {
    pages.map((page) => (
      <div class="flex flex-col md:row-span-3 md:grid md:grid-rows-subgrid">
        <div class="flex min-h-11 items-center font-bold text-typo-high">
          {page.label}
          {page.key === "ai" && (
            <button
              type="button"
              class="grid size-11 -translate-y-[1.5px] place-items-center rounded-full text-typo-medium transition-colors hover:bg-gray-subtle hover:text-typo-high"
              aria-label={t.originLabel}
              aria-haspopup="dialog"
              data-dialog-open="compareOrigin"
            >
              <IconInfoCircle class="size-5" aria-hidden="true" />
            </button>
          )}
        </div>
        <p class="mb-4 text-typo-medium">{page.note}</p>
        <div class="overflow-hidden rounded-2xl bg-gray-min shadow-lg ring-1 ring-black/5">
          <div
            class="flex items-center gap-1.5 border-b border-gray-subtle px-4 py-2.5"
            aria-hidden="true"
          >
            <span class="size-2.5 rounded-full bg-gray-low" />
            <span class="size-2.5 rounded-full bg-gray-low" />
            <span class="size-2.5 rounded-full bg-gray-low" />
            <span class="mx-auto h-5 w-2/5 rounded-md bg-gray-subtle" />
          </div>
          <img
            src={page.image}
            alt=""
            width="1536"
            height="1152"
            loading="lazy"
            decoding="async"
            class="block h-auto w-full"
          />
        </div>
      </div>
    ))
  }
  <figcaption id="compareDescription" class="sr-only">{t.description}</figcaption>
</figure>

<Dialog id="compareOrigin" title={t.originTitle}>
  {t.originText.map((paragraph) => <p>{paragraph}</p>)}
  <h3 class="mt-2 font-bold text-typo-high">{t.promptTitle}</h3>
  <!-- --- Sent in German for both languages, so it carries lang -->
  <pre
    class="rounded-xl bg-gray-subtle p-4 font-mono text-[0.8125rem] leading-relaxed whitespace-pre-wrap text-typo-high"
    lang="de">{t.prompt}</pre>
</Dialog>
