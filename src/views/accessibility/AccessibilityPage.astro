---
import { IconArrowRight } from "@tabler/icons-astro"
import Button from "../../components/ui/Button.astro"
import ScreenReaderCaption from "../../components/ui/ScreenReaderCaption.astro"
import SectionHeading from "../../components/ui/SectionHeading.astro"
import ScreenReaderDemo from "./ScreenReaderDemo.astro"
import { siteConfig } from "../../config/site"
import { useTranslations } from "../../i18n"

const t = useTranslations(Astro.currentLocale).accessibility
const tCommon = useTranslations(Astro.currentLocale).common
const contactHref = `mailto:${siteConfig.contact.email}`
---

<main id="main">
  <section class="ec-layout-visual-content pt-20 pb-24 md:pt-28 md:pb-32">
    <!-- --- The heading and its announcement side by side: what you see, and
         what actually arrives. The claim of this page, made before it is made. -->
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,25rem)] lg:items-center">
      <SectionHeading level={1}>{t.hero.title}</SectionHeading>

      <div class="ec-reveal ec-reveal-late">
        <ScreenReaderCaption>{t.hero.announcement}</ScreenReaderCaption>
        <p class="mt-3 pl-1 text-typo-medium">{t.hero.announcementLabel}</p>
      </div>
    </div>

    <p class="mt-14 max-w-[56ch] ec-reveal text-lead text-typo-medium ec-reveal-late">
      {t.hero.lead}
    </p>

    <Button class="mt-9 ec-reveal ec-reveal-late" href={contactHref}>
      {tCommon.contactCta}
      <IconArrowRight slot="icon-end" class="size-5" />
    </Button>
  </section>

  <section class="bg-brand-blue py-24 md:py-32">
    <div class="ec-layout-visual-content">
      <p class="max-w-[30ch] ec-reveal text-display text-typo-min/65">{t.statement.lead}</p>
      <p class="mt-2 max-w-[30ch] ec-reveal text-display text-brand-green-medium ec-reveal-late">
        {t.statement.emphasis}
      </p>
      <p class="mt-10 max-w-[48ch] ec-reveal text-lead text-typo-min/85 ec-reveal-late">
        {t.statement.body}
      </p>
    </div>
  </section>

  <ScreenReaderDemo />

  <section class="ec-layout-visual-content py-24 md:py-32">
    <SectionHeading level={2}>{t.law.title}</SectionHeading>

    <div
      class="mt-10 grid ec-reveal gap-x-16 gap-y-10 ec-reveal-late lg:grid-cols-[minmax(0,34rem)_minmax(0,1fr)]"
    >
      <div class="flex flex-col gap-5">
        {t.law.body.map((paragraph) => <p class="text-body text-typo-medium">{paragraph}</p>)}
      </div>

      <dl class="flex flex-col gap-7">
        {
          t.law.facts.map((fact) => (
            <div>
              <dt class="text-typo-medium">{fact.term}</dt>
              <dd class="mt-1 text-lead font-bold text-brand-blue">{fact.description}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="bg-gray-min py-24 md:py-32">
    <div class="ec-layout-visual-content">
      <SectionHeading level={2}>{t.services.title}</SectionHeading>

      <p class="mt-6 max-w-[54ch] ec-reveal text-body text-typo-medium ec-reveal-late">
        {t.services.lead}
      </p>

      <!-- --- Not numbered: the copy says each one can be booked on its own, so
           a sequence would promise an order that does not exist. --- -->
      <ul role="list" class="mt-16 grid ec-reveal gap-x-12 gap-y-14 md:grid-cols-3">
        {
          t.services.items.map((service) => (
            <li class="flex flex-col">
              <h3 class="text-heading-1">{service.title}</h3>

              <p class="mt-4 text-lead font-bold text-brand-blue">{service.result}</p>

              <p class="mt-6 text-typo-medium">{service.lead}</p>

              <ul role="list" class="mt-7 flex flex-col gap-3 text-typo-medium">
                {service.items.map((item) => (
                  <li class="flex gap-3">
                    <span
                      class="mt-2.5 size-1.5 shrink-0 rounded-full bg-brand-green-high"
                      aria-hidden="true"
                    />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="ec-layout-visual-content py-24 md:py-32">
    <SectionHeading level={2}>{t.why.title}</SectionHeading>

    <div
      class="mt-10 grid ec-reveal gap-10 ec-reveal-late lg:grid-cols-[minmax(0,18rem)_minmax(0,1fr)] lg:gap-16"
    >
      <img
        src="/images/portraitcan.png"
        alt={t.why.portraitAlt}
        width="400"
        height="500"
        class="h-fit w-full rounded-3xl object-cover"
      />

      <div class="flex max-w-[62ch] flex-col gap-5">
        <p class="text-lead text-typo-high">{t.why.body[0]}</p>

        {
          t.why.body
            .slice(1)
            .map((paragraph) => <p class="text-body text-typo-medium">{paragraph}</p>)
        }
      </div>
    </div>
  </section>

  <section class="bg-brand-blue py-20 md:py-24">
    <div
      class="ec-layout-visual-content grid gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-20"
    >
      <div>
        <SectionHeading level={2} class="text-typo-min">{t.contact.title}</SectionHeading>
        <p class="mt-5 max-w-[54ch] ec-reveal text-body text-typo-min/85 ec-reveal-late">
          {t.contact.body}
        </p>
      </div>

      <div class="flex ec-reveal flex-col items-start gap-5 ec-reveal-late">
        <Button href={contactHref}>
          {tCommon.contactCta}
          <IconArrowRight slot="icon-end" class="size-5" />
        </Button>

        <a
          href={contactHref}
          class="text-body text-typo-min/85 underline underline-offset-4 transition-colors hover:text-typo-min"
        >
          {siteConfig.contact.email}
        </a>
      </div>
    </div>
  </section>
</main>
