---
// --- Accessibility offer page. Built along the questions a client brings:
// what is this about (demo), what do I get (services), does it apply to me
// (law), how does it work (process), why you (one hand), the usual doubts
// (questions).
import {
  IconArrowRight,
  IconCheck,
  IconMinus,
  IconSchool,
  IconTool,
  IconZoomCheck,
} from "@tabler/icons-astro"
import ContactSection from "../../components/ContactSection.astro"
import FaqSection from "../../components/FaqSection.astro"
import OneHandSection from "../../components/OneHandSection.astro"
import ProcessScene from "../../components/ProcessScene.astro"
import ServicesSection from "../../components/ServicesSection.astro"
import Button from "../../components/ui/Button.astro"
import ScreenReaderCaption from "../../components/ui/ScreenReaderCaption.astro"
import Section from "../../components/ui/Section.astro"
import ScreenReaderDemo from "./ScreenReaderDemo.astro"
import { siteConfig } from "../../config/site"
import { inquiryPath, useTranslations, type Locale } from "../../i18n"

const currentLocale = (Astro.currentLocale ?? siteConfig.defaultLocale) as Locale
const t = useTranslations(currentLocale).accessibility
const tCommon = useTranslations(currentLocale).common
const inquiryHref = inquiryPath(currentLocale, "accessibility")

// --- One icon per service, in the order of the copy: audit (the magnifier of the
// start page's role scene), fixing, training
const serviceIcons = [IconZoomCheck, IconTool, IconSchool]
---

<main id="main">
  <section
    class="ec-layout-visual-content pt-[calc(var(--spacing-header)+4rem)] pb-20 md:pt-[calc(var(--spacing-header)+6rem)] md:pb-28"
  >
    <!-- --- The heading and its announcement side by side: what you see, and
         what actually arrives -->
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,25rem)] lg:items-end lg:gap-16">
      <h1 class="ec-rise text-display text-balance">{t.hero.title}</h1>

      <!-- --- Hidden from screen readers: they have just heard exactly this, and
           the quote before its label would only repeat the heading -->
      <div class="ec-rise [--ec-rise-delay:450ms]" aria-hidden="true">
        <ScreenReaderCaption>{t.hero.announcement}</ScreenReaderCaption>
        <p class="mt-3 pl-1 text-sm text-typo-medium">{t.hero.announcementLabel}</p>
      </div>
    </div>

    <p class="mt-10 max-w-[52ch] ec-rise text-lead text-typo-medium [--ec-rise-delay:150ms]">
      {t.hero.lead}
    </p>

    <div class="mt-9 w-fit ec-rise [--ec-rise-delay:250ms]" data-inquiry-cta>
      <Button href={inquiryHref}>
        {tCommon.contactCta}
        <IconArrowRight slot="icon-end" class="size-5" />
      </Button>
    </div>
  </section>

  <ScreenReaderDemo />

  <ServicesSection
    title={t.services.title}
    lead={t.services.lead}
    items={t.services.items}
    icons={serviceIcons}
  />

  <!-- --- The law: prose on the left, the answer to "does this apply to me" on
       the right -->
  <Section tone="light">
    <h2 class="ec-reveal text-heading-1 text-balance">{t.law.title}</h2>
    <div
      class="mt-10 grid ec-reveal gap-x-16 gap-y-10 ec-reveal-late lg:grid-cols-[minmax(0,1fr)_minmax(0,24rem)]"
    >
      <div class="flex max-w-[60ch] flex-col gap-5">
        {t.law.body.map((paragraph) => <p class="text-body text-typo-medium">{paragraph}</p>)}
      </div>

      <ul role="list" class="flex flex-col gap-7">
        <li class="flex items-start gap-4">
          <span
            class="grid size-10 shrink-0 place-items-center rounded-full bg-brand-green-low/70 text-brand-blue"
            aria-hidden="true"
          >
            <IconCheck class="size-5" />
          </span>
          <p class="pt-1">
            <span class="block text-lead text-typo-high">{t.law.affectedTitle}</span>
            <span class="mt-1 block text-typo-medium">{t.law.affected}</span>
          </p>
        </li>
        <li class="flex items-start gap-4">
          <span
            class="grid size-10 shrink-0 place-items-center rounded-full bg-gray-low/70 text-typo-high"
            aria-hidden="true"
          >
            <IconMinus class="size-5" />
          </span>
          <p class="pt-1">
            <span class="block text-lead text-typo-high">{t.law.notAffectedTitle}</span>
            <span class="mt-1 block text-typo-medium">{t.law.notAffected}</span>
          </p>
        </li>
      </ul>
    </div>
  </Section>

  <!-- --- Process as an ordered list. Each step says what the reader has
       afterwards. On desktop the VoiceOver frame from the demo glides to the step
       being read, and the scene in the sticky column (ProcessScene) changes into
       it. Below lg every step carries its own scene, already in its state. The visual "01" is hidden from screen readers, the list numbers them. -->
  <Section>
    <div class="ec-process grid gap-12 lg:grid-cols-[minmax(0,24rem)_minmax(0,1fr)] lg:gap-20">
      <div class="lg:sticky lg:top-[calc(var(--spacing-header)+2rem)] lg:self-start">
        <h2 class="ec-reveal text-heading-1 text-balance">{t.process.title}</h2>
        <p class="mt-5 ec-reveal text-lead text-typo-medium ec-reveal-late">{t.process.lead}</p>
        <ProcessScene
          class="ec-process-scene mt-10 hidden h-80 rounded-3xl bg-gray-min shadow-sm lg:block"
        />
      </div>

      <div class="relative">
        <ol role="list" class="flex ec-reveal flex-col gap-4 ec-reveal-late">
          {
            t.process.steps.map((step, index) => (
              <li
                class="ec-process-step rounded-2xl p-5 transition-[background-color,box-shadow] duration-300 lg:p-6 lg:data-[is-active=true]:bg-gray-min lg:data-[is-active=true]:shadow-sm"
                data-is-active={index === 0 ? "true" : "false"}
              >
                <ProcessScene
                  step={(index + 1) as 1 | 2 | 3 | 4}
                  isCompact
                  class="mb-6 h-56 ec-reveal rounded-3xl bg-gray-min shadow-sm lg:hidden"
                />
                <span
                  class="text-sm font-bold tracking-[0.12em] text-typo-medium"
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3 class="mt-1 text-heading-2">{step.title}</h3>
                <p class="mt-3 max-w-[52ch] text-typo-medium">{step.text}</p>
              </li>
            ))
          }
        </ol>
        <span class="ec-process-cursor hidden lg:block" aria-hidden="true"></span>
      </div>
    </div>
  </Section>

  <OneHandSection
    title={t.oneHand.title}
    body={t.oneHand.body}
    portraitAlt={t.oneHand.portraitAlt}
  />

  <FaqSection title={t.faq.title} items={t.faq.items} />

  <ContactSection title={t.contact.title} body={t.contact.body} topic="accessibility" />
</main>

<script>
  // --- The step whose top has passed the middle of the viewport is the one
  // being read: the frame moves onto it. Worked out per frame from positions,
  // like the roles on the start page, so it is the same answer scrolling up or
  // down.
  const process = document.querySelector<HTMLElement>(".ec-process")
  if (process) {
    const steps = [...process.querySelectorAll<HTMLElement>(".ec-process-step")]
    const cursor = process.querySelector<HTMLElement>(".ec-process-cursor")!
    const scene = process.querySelector<HTMLElement>(".ec-process-scene")!
    const desktop = window.matchMedia("(width >= 64rem)")
    let activeIndex = -1
    let isTicking = false

    const update = (isInstant = false) => {
      isTicking = false
      if (!desktop.matches) return
      const centre = window.innerHeight / 2
      let index = 0
      steps.forEach((step, stepIndex) => {
        if (step.getBoundingClientRect().top <= centre) index = stepIndex
      })
      if (index === activeIndex && !isInstant) return
      activeIndex = index

      steps.forEach((step, stepIndex) => {
        step.dataset.isActive = String(stepIndex === index)
      })
      scene.dataset.step = String(index + 1)
      const step = steps[index]
      if (isInstant) process.dataset.isPlacing = "true"
      cursor.style.transform = `translateY(${step.offsetTop}px)`
      cursor.style.height = `${step.offsetHeight}px`
      if (isInstant) requestAnimationFrame(() => delete process.dataset.isPlacing)
    }

    window.addEventListener(
      "scroll",
      () => {
        if (isTicking) return
        isTicking = true
        requestAnimationFrame(() => update())
      },
      { passive: true }
    )
    window.addEventListener("resize", () => update(true))
    update(true)
  }
</script>

<style>
  /* --- The VoiceOver frame from the demo (same colour and weight), gliding to
     the step being read --- */
  .ec-process-cursor {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    border: 3px solid #0b0c0e;
    border-radius: 1rem;
    pointer-events: none;
    transition:
      transform 420ms cubic-bezier(0.2, 0.8, 0.2, 1),
      height 420ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .ec-process[data-is-placing="true"] .ec-process-cursor {
    transition: none;
  }
</style>
