---
// --- "Looks the same": one ordinary form, element by element. On the left
// what is seen, with the screen reader frame on the current element; on the
// right what is heard, the common mistake and the right build one under the
// other, and a dialog that explains the why. "Back" and "Next" are the
// controls for everyone. A click or tap on the picture is a pointer shortcut
// to the same thing, so the picture needs no role, name or keyboard support of
// its own. It is drawn in a neutral style of "some other site" and hidden from
// screen readers; the panel is real text they can read, and a live region
// names the element after each step.
import {
  IconArrowDown,
  IconArrowLeft,
  IconArrowRight,
  IconCheck,
  IconChevronRight,
  IconEyeOff,
  IconInfoCircle,
  IconShieldLock,
  IconVolume,
  IconX,
} from "@tabler/icons-astro"
import Button from "../../components/ui/Button.astro"
import Dialog from "../../components/ui/Dialog.astro"
import InlineText from "../../components/ui/InlineText.astro"
import ScreenReaderCaption from "../../components/ui/ScreenReaderCaption.astro"
import { useTranslations } from "../../i18n"
import { fill } from "../../i18n/fill"

const t = useTranslations(Astro.currentLocale).accessibility.demo

const scriptText = {
  cases: t.cases.map(({ details: _details, ...demoCase }) => demoCase),
  silent: t.silent,
  position: t.position,
  liveTemplate: t.liveTemplate,
}

// --- Rendered with the first element, so the panel is never empty and works
// without script
const firstCase = t.cases[0]
const firstPosition = fill(t.position, { number: "1", total: String(t.cases.length) })
---

<section class="bg-gray-min py-20 md:py-28">
  <div class="ec-demo ec-layout-visual-content" data-text={JSON.stringify(scriptText)}>
    <h2 class="ec-reveal text-heading-1 text-balance">{t.title}</h2>
    <p class="mt-5 max-w-[56ch] ec-reveal text-lead text-typo-medium ec-reveal-late">{t.lead}</p>
    <!-- --- How to use the demo: a different job from the lead, so smaller and apart -->
    <p class="mt-4 max-w-[56ch] ec-reveal text-sm text-typo-medium ec-reveal-late">
      {t.instruction}
      <span class="max-lg:hidden">{" "}{t.instructionCurtain}</span>
    </p>

    <!-- --- One grid, arranged in ec-demo-layout below. DOM order: curtain,
         picture, controls, then the panel they change, so a screen reader reaches
         the result right after the button. -->
    <div class="ec-demo-layout mt-12 ec-reveal ec-reveal-late" data-is-blind="false">
      <!-- --- Desktop only: on a phone the curtain would black out the one
           picture the buttons are about -->
      <div class="ec-demo-settings hidden lg:mt-10 lg:block lg:pt-8">
        <button
          type="button"
          role="switch"
          aria-checked="false"
          class="ec-demo-blind group inline-flex min-h-11 items-center gap-3 text-typo-high"
        >
          {t.blind}
          <span
            class="relative h-7 w-12 rounded-full border-2 border-typo-medium transition-colors duration-200 group-aria-checked:border-brand-blue group-aria-checked:bg-brand-blue"
            aria-hidden="true"
          >
            <span
              class="absolute top-1 left-1 size-4 rounded-full bg-typo-medium transition-[translate,background-color] duration-200 group-aria-checked:translate-x-5 group-aria-checked:bg-gray-min"
            ></span>
          </span>
        </button>
      </div>

      <!-- --- The picture: nothing in it is focusable, so aria-hidden is
           enough. A click on an element selects it (see the script). -->
      <div class="ec-demo-stage relative" aria-hidden="true">
        <div class="flex flex-col gap-4 rounded-3xl bg-gray-subtle p-6 sm:p-8">
          <span
            class="grid size-11 place-items-center rounded-xl bg-gray-low/70 text-typo-medium"
            data-target="0"
          >
            <IconShieldLock class="size-6" />
          </span>

          <span class="w-fit text-heading-2" data-target="1">{t.formTitle}</span>

          <span class="-mb-2 w-fit text-typo-medium">
            {t.nameLabel}<span class="text-status-error-text">*</span>
          </span>
          <span
            class="flex min-h-13 items-center rounded-xl border-2 border-gray-low bg-gray-min px-4"
            data-target="2"
          >
            {t.nameValue}
          </span>

          <span class="-mb-2 w-fit text-typo-medium">
            {t.emailLabel}<span class="text-status-error-text">*</span>
          </span>
          <span class="flex flex-col gap-1.5" data-target="3">
            <span
              class="flex min-h-13 items-center rounded-xl border-2 border-status-error-text bg-status-error-bg px-4"
            >
              {t.emailValue}
            </span>
            <span class="text-sm text-status-error-text">{t.emailError}</span>
          </span>

          <!-- --- Deliberately quiet, so it is not taken for the demo's own "Next" -->
          <span
            class="mt-1 grid size-11 place-items-center rounded-xl border-2 border-gray-low bg-gray-min text-typo-medium"
            data-target="4"
          >
            <IconChevronRight class="size-5" />
          </span>
        </div>

        <!-- --- One frame that travels from part to part, the way the VoiceOver
             cursor does -->
        <span class="ec-vo-cursor"></span>
      </div>

      <div class="ec-curtain" aria-hidden="true">
        <div class="flex flex-col items-center gap-4 text-center">
          <IconEyeOff class="size-8 text-brand-green-medium" />
          <p class="max-w-[18rem] text-lead text-typo-min">{t.curtainText}</p>
        </div>
      </div>

      <!-- --- Phones: buttons and the pill under them form one group. Once the
           picture is a third in view, it docks to the bottom of the screen,
           each part a floating island with the shadow of the header; scrolled
           down, it rests under the picture. The pill never covers the buttons
           and nothing appears or disappears, so the focus order stays the same.
           Desktop: the group dissolves, the buttons sit in the row below the
           rule and the pill is not needed. -->
      <div class="ec-demo-controls" data-is-docked="false">
        <div class="ec-demo-nav flex items-center justify-center gap-3 lg:mt-10 lg:pt-8">
          <!-- --- The quiet partner of "Next": the grey button variant, not the
             secondary one, whose green text does not reach 4.5:1 yet (see
             docs/open-points.md). -->
          <Button type="button" variant="quiet" class="ec-demo-previous">
            <IconArrowLeft slot="icon-start" class="size-5" />
            {t.previous}
          </Button>
          <Button type="button" class="ec-demo-next">
            {t.next}
            <IconArrowRight slot="icon-end" class="size-5" />
          </Button>
        </div>

        <!-- --- A small pill in the look of the VoiceOver caption that leads down
             to the announcements, and bumps on every new element. A real button:
             it scrolls to the element's name and puts the focus there. -->
        <button type="button" class="ec-demo-jump">
          <IconVolume class="size-5 text-typo-min/70" aria-hidden="true" />
          {t.jump}
          <IconArrowDown class="size-5" aria-hidden="true" />
        </button>
      </div>

      <!-- --- What is heard: the element, then both builds. The icons carry the
           verdict besides the colour, the labels say it in words. -->
      <div class="ec-demo-panel max-lg:mt-8">
        <p class="ec-demo-position text-sm text-typo-medium">{firstPosition}</p>
        <h3 class="ec-demo-name mt-1 scroll-mt-28 text-heading-2" tabindex="-1">
          {firstCase.name}
        </h3>

        <div class="mt-6 flex flex-col gap-6">
          {
            (["common", "correct"] as const).map((variant) => (
              <div class:list={[variant === "correct" && "ec-demo-correct"]}>
                <p class="flex items-center gap-2.5 text-sm font-bold text-typo-high">
                  <span
                    class:list={[
                      "grid size-6 place-items-center rounded-full",
                      variant === "common"
                        ? "bg-status-error-bg text-status-error-text"
                        : "bg-brand-green-low text-brand-blue",
                    ]}
                    aria-hidden="true"
                  >
                    {variant === "common" ? (
                      <IconX class="size-4" stroke-width={2.5} />
                    ) : (
                      <IconCheck class="size-4" stroke-width={2.5} />
                    )}
                  </span>
                  {variant === "common" ? t.commonLabel : t.correctLabel}
                </p>
                <ScreenReaderCaption
                  textId={`demo-${variant}`}
                  isSilent={
                    variant === "common" ? firstCase.isCommonSilent : firstCase.isCorrectSilent
                  }
                  class="mt-3"
                >
                  {(variant === "common" ? firstCase.isCommonSilent : firstCase.isCorrectSilent)
                    ? t.silent
                    : variant === "common"
                      ? firstCase.common
                      : firstCase.correct}
                </ScreenReaderCaption>
              </div>
            ))
          }
        </div>

        <!-- --- The why is extra reading, so it opens in a dialog: unfolding it
             here would push the buttons below down -->
        <button
          type="button"
          class="ec-demo-why mt-6 inline-flex min-h-11 items-center gap-2 rounded-lg font-bold text-brand-blue underline-offset-4 hover:underline"
          aria-haspopup="dialog"
          data-dialog-open="demoDialog"
        >
          <IconInfoCircle class="size-5 -translate-y-0.5" aria-hidden="true" />
          {t.whyButton}
        </button>
      </div>

      <span
        class="ec-demo-rule hidden border-t border-gray-low lg:mt-10 lg:block"
        aria-hidden="true"></span>
    </div>

    <p class="sr-only" id="demoAnnouncement" aria-live="polite"></p>

    <!-- --- Filled with the current element's title and paragraphs when it opens -->
    <Dialog id="demoDialog" title={firstCase.name} />

    {
      t.cases.map((demoCase) => (
        <template class="ec-demo-details">
          {demoCase.details.map((paragraph) => (
            <p>
              <InlineText text={paragraph} />
            </p>
          ))}
        </template>
      ))
    }
  </div>
</section>

<style>
  /* --- The VoiceOver cursor: near black, which clears 3:1 on the light form --- */
  .ec-vo-cursor {
    position: absolute;
    top: 0;
    left: 0;
    border: 3px solid #0b0c0e;
    border-radius: 0.875rem;
    opacity: 0;
    pointer-events: none;
    transition:
      transform 320ms cubic-bezier(0.2, 0.8, 0.2, 1),
      width 320ms cubic-bezier(0.2, 0.8, 0.2, 1),
      height 320ms cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 200ms ease;
  }

  .ec-demo-stage[data-has-cursor="true"] .ec-vo-cursor {
    opacity: 1;
  }

  /* --- Before the first step the cursor has no place yet; it appears where it
     starts instead of flying in from the corner --- */
  .ec-demo-stage[data-is-placing="true"] .ec-vo-cursor {
    transition: opacity 200ms ease;
  }

  /* --- Same cell as the picture, painted above it --- */
  .ec-curtain {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    border-radius: 1.5rem;
    background: #0b0c0e;
    padding: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 450ms ease;
  }

  .ec-demo-layout[data-is-blind="true"] .ec-curtain {
    opacity: 1;
  }

  /* --- Phones: curtain, picture, the two buttons right below it, then what is
     heard. Desktop: what is seen on the left, what is heard on the right, the
     curtain and the buttons in one row below the rule. The panel keeps the
     height of its longest element, so that row never jumps. --- */
  .ec-demo-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "settings"
      "screen"
      "nav"
      "panel";

    @media (width >= 64rem) {
      grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
      grid-template-areas:
        "screen panel"
        "settings nav";
      column-gap: 4rem;
    }
  }

  .ec-demo-settings {
    grid-area: settings;
  }

  .ec-demo-stage {
    grid-area: screen;
  }

  /* --- The hand only over the elements themselves, the way a page shows what
     can be clicked. Behind the curtain there is nothing to aim at. --- */
  .ec-demo-layout[data-is-blind="false"] [data-target] {
    cursor: pointer;
  }

  .ec-curtain {
    grid-area: screen;
  }

  .ec-demo-controls {
    grid-area: nav;

    @media (width < 64rem) {
      bottom: calc(1rem + env(safe-area-inset-bottom));
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.875rem;
      margin-block: 2rem 0.5rem;

      &[data-is-docked="true"] {
        position: sticky;
      }

      & :is(button, .ec-button) {
        box-shadow: var(--shadow-island);
      }
    }

    @media (width >= 64rem) {
      display: contents;
    }
  }

  .ec-demo-nav {
    grid-area: nav;

    @media (width >= 64rem) {
      justify-self: end;
    }
  }

  .ec-demo-panel {
    grid-area: panel;
  }

  .ec-demo-rule {
    grid-column: 1 / -1;
    grid-row: 2;
    align-self: start;
  }

  .ec-demo-jump {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    border-radius: 9999px;
    background: rgb(28 28 30 / 0.96);
    padding: 0.5rem 1.125rem;
    color: #ffffff;
    font-weight: 700;
    white-space: nowrap;
    box-shadow: 0 14px 36px -14px rgb(0 0 0 / 0.5);

    &[data-is-fresh="true"] {
      animation: ec-jump-bump 450ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    @media (width >= 64rem) {
      display: none;
    }
  }

  @keyframes ec-jump-bump {
    40% {
      scale: 1.08;
    }
  }
</style>

<script>
  import { fill } from "../../i18n/fill"
  import type { DemoCase } from "../../i18n/types"

  const demo = document.querySelector<HTMLElement>(".ec-demo")
  if (demo) {
    const text = JSON.parse(demo.dataset.text ?? "{}")
    const cases: Omit<DemoCase, "details">[] = text.cases
    const layout = demo.querySelector<HTMLElement>(".ec-demo-layout")!
    const stage = demo.querySelector<HTMLElement>(".ec-demo-stage")!
    const cursor = stage.querySelector<HTMLElement>(".ec-vo-cursor")!
    const targets = [...stage.querySelectorAll<HTMLElement>("[data-target]")]
    const panel = demo.querySelector<HTMLElement>(".ec-demo-panel")!
    const position = panel.querySelector<HTMLElement>(".ec-demo-position")!
    const caseName = panel.querySelector<HTMLElement>(".ec-demo-name")!
    const announcement = demo.querySelector<HTMLElement>("#demoAnnouncement")!
    const blindSwitch = demo.querySelector<HTMLButtonElement>(".ec-demo-blind")!
    const variants = (["common", "correct"] as const).map((variant) => ({
      variant,
      caption: demo.querySelector<HTMLElement>(`#demo-${variant}`)!,
    }))
    const jump = demo.querySelector<HTMLElement>(".ec-demo-jump")!
    const phone = window.matchMedia("(width < 64rem)")
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")
    const dialogTitle = document.querySelector<HTMLElement>("#demoDialogTitle")!
    const dialogBody = document.querySelector<HTMLElement>("#demoDialog .ec-dialog-body")!
    const detailTemplates = [...demo.querySelectorAll<HTMLTemplateElement>(".ec-demo-details")]

    let index = 0

    // --- The cursor sits a little outside the part it frames
    const placeCursor = () => {
      const target = targets[index]
      if (!target) return
      const stageRect = stage.getBoundingClientRect()
      const rect = target.getBoundingClientRect()
      const gap = 8
      cursor.style.transform = `translate(${rect.left - stageRect.left - gap}px, ${rect.top - stageRect.top - gap}px)`
      cursor.style.width = `${rect.width + gap * 2}px`
      cursor.style.height = `${rect.height + gap * 2}px`
    }

    const render = (demoCase: Omit<DemoCase, "details">, number: number) => {
      const positionText = fill(text.position, {
        number: String(number),
        total: String(cases.length),
      })
      position.textContent = positionText
      caseName.textContent = demoCase.name
      for (const { variant, caption } of variants) {
        const isSilent =
          variant === "common"
            ? demoCase.isCommonSilent === true
            : demoCase.isCorrectSilent === true
        caption.textContent = isSilent ? text.silent : demoCase[variant]
        caption.closest(".ec-caption")?.setAttribute("data-is-silent", String(isSilent))
      }
      return positionText
    }

    const select = (newIndex: number) => {
      index = (newIndex + cases.length) % cases.length
      placeCursor()
      const positionText = render(cases[index], index + 1)
      announcement.textContent = fill(text.liveTemplate, {
        position: positionText,
        name: cases[index].name,
      })
      revealTarget()
      // --- Phones: a nudge that something new is waiting below
      if (phone.matches) {
        delete jump.dataset.isFresh
        void jump.offsetWidth
        jump.dataset.isFresh = "true"
      }
    }

    // --- Phones: the group docks while the picture is at least a third in
    // view. Once the picture has scrolled past, docking changes nothing: the
    // group already rests in its place below it.
    const controls = demo.querySelector<HTMLElement>(".ec-demo-controls")!
    new IntersectionObserver(
      ([entry]) => {
        controls.dataset.isDocked = String(
          entry.intersectionRatio >= 1 / 3 || entry.boundingClientRect.top < 0
        )
      },
      { threshold: [0, 1 / 3, 1] }
    ).observe(stage)

    // --- Phones: the docked buttons must never hide the framed element. If it
    // sits behind them (or under the header), scroll just far enough to show it.
    const revealTarget = () => {
      const target = targets[index]
      if (!phone.matches || !target) return
      target.style.scrollMarginBottom = `${controls.offsetHeight + 32}px`
      target.style.scrollMarginTop = "7rem"
      target.scrollIntoView({
        block: "nearest",
        behavior: reducedMotion.matches ? "auto" : "smooth",
      })
    }

    jump.addEventListener("click", () => {
      caseName.scrollIntoView({ behavior: reducedMotion.matches ? "auto" : "smooth" })
      caseName.focus({ preventScroll: true })
    })

    // --- Desktop: the panel keeps the height of its longest element, measured
    // by rendering each one once, so the buttons in the row below never jump.
    // Phones have the buttons above the panel, so it simply takes its height.
    const holdPanelHeight = () => {
      panel.style.minHeight = ""
      if (phone.matches) return
      let tallest = 0
      cases.forEach((demoCase, caseIndex) => {
        render(demoCase, caseIndex + 1)
        tallest = Math.max(tallest, panel.offsetHeight)
      })
      panel.style.minHeight = `${tallest}px`
      render(cases[index], index + 1)
    }

    demo.querySelector(".ec-demo-next")!.addEventListener("click", () => select(index + 1))
    demo.querySelector(".ec-demo-previous")!.addEventListener("click", () => select(index - 1))

    // --- A click or tap on an element of the picture selects it; a click
    // beside one does nothing. Ignored behind the curtain.
    stage.addEventListener("click", (event) => {
      if (layout.dataset.isBlind === "true" || !(event.target instanceof Element)) return
      const target = event.target.closest<HTMLElement>("[data-target]")
      if (target) select(targets.indexOf(target))
    })

    // --- The dialog opens itself (data-dialog-open); this fills it with the
    // current element in the same click
    demo.querySelector(".ec-demo-why")!.addEventListener("click", () => {
      dialogTitle.textContent = cases[index].name
      dialogBody.replaceChildren(detailTemplates[index].content.cloneNode(true))
    })

    blindSwitch.addEventListener("click", () => {
      const isBlind = blindSwitch.getAttribute("aria-checked") !== "true"
      blindSwitch.setAttribute("aria-checked", String(isBlind))
      layout.dataset.isBlind = String(isBlind)
    })

    // --- First element framed from the start, without flying in from the corner
    stage.dataset.isPlacing = "true"
    placeCursor()
    stage.dataset.hasCursor = "true"
    requestAnimationFrame(() => delete stage.dataset.isPlacing)
    holdPanelHeight()

    // --- The web font changes line breaks, so measure again once it is in
    document.fonts.ready.then(() => {
      placeCursor()
      holdPanelHeight()
    })

    window.addEventListener("resize", () => {
      placeCursor()
      holdPanelHeight()
    })
  }
</script>
