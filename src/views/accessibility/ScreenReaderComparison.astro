---
// --- One form step, five elements, two screen reader transcripts side by side.
import {
  IconAlertCircle,
  IconChevronRight,
  IconPointerFilled,
  IconShieldLock,
  IconX,
} from "@tabler/icons-astro"
import { useTranslations } from "../../i18n"

const t = useTranslations(Astro.currentLocale).accessibility.demo

// --- The required marker sits mid-sentence in German and at the end in English,
// so the sentence is one string with a placeholder rather than glued fragments.
const [legendBeforeMark, legendAfterMark] = t.requiredLegend.split("{mark}")
---

<section class="ec-layout-visual-content pb-8">
  <p
    class="mb-7 flex items-center gap-3.5 rounded-2xl bg-brand-green-medium/20 px-5 py-4 text-body font-bold text-brand-green-high"
  >
    <span
      class="grid size-9 shrink-0 place-items-center rounded-full bg-brand-green-medium"
      aria-hidden="true"
    >
      <IconPointerFilled class="size-5 text-brand-blue" />
    </span>
    <span>{t.instruction}</span>
  </p>

  <div
    class="flex flex-col gap-7 rounded-3xl border border-gray-low bg-gray-min p-6 shadow-sm sm:p-9"
  >
    <div class="flex items-center gap-3.5">
      <button
        type="button"
        class="ec-sr-target relative block cursor-pointer rounded-xl text-left"
        data-case="0"
        aria-current="false"
      >
        <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-brand-green-medium/20">
          <IconShieldLock class="size-6 text-brand-green-high" aria-hidden="true" />
        </span>
        <span class="sr-only">{t.targets.symbol}</span>
      </button>

      <button
        type="button"
        class="ec-sr-target relative block cursor-pointer rounded-xl text-left"
        data-case="1"
        aria-current="false"
      >
        <span class="text-heading-2">{t.formTitle}</span>
      </button>
    </div>

    <p class="-mt-3 text-typo-medium">
      {legendBeforeMark}<span class="font-bold text-status-error-text">*</span>{legendAfterMark}
    </p>

    <div class="flex flex-col gap-2.5">
      <span class="text-typo-medium">
        {t.nameLabel}
        <span class="font-bold text-status-error-text">*</span>
      </span>
      <button
        type="button"
        class="ec-sr-target relative block w-full cursor-pointer rounded-xl text-left"
        data-case="2"
        aria-current="false"
      >
        <span
          class="flex min-h-13 items-center rounded-xl border-2 border-gray-low bg-gray-min px-4 py-3.5 text-body"
        >
          {t.nameValue}
        </span>
        <span class="sr-only">{t.targets.nameField}</span>
      </button>
    </div>

    <div class="flex flex-col gap-2.5">
      <span class="text-typo-medium">
        {t.emailLabel}
        <span class="font-bold text-status-error-text">*</span>
      </span>
      <button
        type="button"
        class="ec-sr-target relative block w-full cursor-pointer rounded-xl text-left"
        data-case="3"
        aria-current="false"
      >
        <span
          class="flex min-h-13 items-center rounded-xl border-2 border-status-error-text bg-status-error-bg px-4 py-3.5 text-body"
        >
          {t.emailValue}
        </span>
        <span class="sr-only">{t.targets.emailField}</span>
      </button>
      <p class="flex items-center gap-2 text-body text-status-error-text">
        <IconAlertCircle class="size-5 shrink-0" aria-hidden="true" />
        <span>{t.emailError}</span>
      </p>
    </div>

    <div class="flex justify-end">
      <button
        type="button"
        class="ec-sr-target relative block cursor-pointer rounded-xl text-left"
        data-case="4"
        aria-current="false"
      >
        <span class="grid size-14 place-items-center rounded-full bg-brand-green-medium">
          <IconChevronRight class="size-6 text-brand-blue" aria-hidden="true" />
        </span>
        <span class="sr-only">{t.targets.submit}</span>
      </button>
    </div>
  </div>

  <p class="sr-only" id="screenReaderAnnouncement" aria-live="polite"></p>

  <div
    class="mt-7 grid scroll-mb-4 grid-cols-1 gap-5 md:grid-cols-2 md:gap-6"
    id="voiceOverPanels"
    aria-hidden="true"
    data-silent-text={t.silent}
    data-live-template={t.liveTemplate}
    data-announcements={JSON.stringify(t.announcements)}
  >
    <div class="flex h-full flex-col gap-3">
      <h3 class="flex items-center gap-2 text-label text-brand-purple uppercase">
        <span class="size-2.5 shrink-0 rounded-full bg-brand-purple" aria-hidden="true"></span>
        {t.columnCommon}
      </h3>
      <div
        class="ec-vo-panel flex min-h-38 flex-1 items-start gap-3.5 border-[3px] border-white px-5.5 pt-4.5 pb-10 backdrop-blur-md"
      >
        <IconX class="mt-1 size-5.5 shrink-0 text-white" aria-hidden="true" />
        <p class="ec-vo-say m-0 leading-snug tracking-normal text-white" id="voiceOverCommon">
          {t.placeholder}
        </p>
      </div>
    </div>

    <div class="flex h-full flex-col gap-3">
      <h3 class="flex items-center gap-2 text-label text-brand-green-high uppercase">
        <span class="size-2.5 shrink-0 rounded-full bg-brand-green-medium" aria-hidden="true"
        ></span>
        {t.columnCorrect}
      </h3>
      <div
        class="ec-vo-panel flex min-h-38 flex-1 items-start gap-3.5 border-[3px] border-white px-5.5 pt-4.5 pb-10 backdrop-blur-md"
      >
        <IconX class="mt-1 size-5.5 shrink-0 text-white" aria-hidden="true" />
        <p class="ec-vo-say m-0 leading-snug tracking-normal text-white" id="voiceOverCorrect">
          {t.placeholder}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* --- VoiceOver caption panel, rebuilt from a macOS screenshot. Only the values
     with no readable utility form: translucent fill, its shadow, and a radius
     between rounded-2xl and rounded-3xl. --- */
  .ec-vo-panel {
    border-radius: 1.25rem;
    background: rgb(40 40 42 / 0.94);
    box-shadow: 0 14px 36px -12px rgb(0 0 0 / 0.45);
  }

  /* --- System font on purpose: quoting macOS, not our brand --- */
  .ec-vo-say {
    font-family:
      ui-sans-serif,
      -apple-system,
      "SF Pro Text",
      system-ui,
      sans-serif;
    font-size: clamp(1.125rem, 1.9vw, 1.4375rem);
  }

  .ec-vo-say[data-is-silent="true"] {
    color: #9ba3ae;
    font-style: italic;
  }

  /* --- Ring imitates the screen reader cursor; the real focus ring stays alongside.
     A pseudo element with content and a negative inset has no utility form. --- */
  .ec-sr-target::after {
    content: "";
    position: absolute;
    inset: -0.625rem;
    border: 4px solid #0b0c0e;
    border-radius: 1rem;
    opacity: 0;
    transition: opacity 160ms ease;
    pointer-events: none;
  }

  .ec-sr-target[aria-current="true"]::after {
    opacity: 1;
  }

  .ec-sr-target[aria-current="true"] {
    z-index: 1;
  }

  .ec-sr-target:hover:not([aria-current="true"])::after {
    opacity: 0.2;
  }
</style>

<script>
  type Announcement = {
    common: string
    correct: string
    isCommonSilent?: boolean
    isCorrectSilent?: boolean
  }

  const panels = document.getElementById("voiceOverPanels")
  const targets = Array.from(document.querySelectorAll<HTMLButtonElement>(".ec-sr-target"))
  const commonOutput = document.getElementById("voiceOverCommon")
  const correctOutput = document.getElementById("voiceOverCorrect")
  const liveRegion = document.getElementById("screenReaderAnnouncement")

  const announcements: Announcement[] = JSON.parse(panels?.dataset.announcements ?? "[]")
  const silentText = panels?.dataset.silentText ?? ""
  const liveTemplate = panels?.dataset.liveTemplate ?? "{common} {correct}"

  function renderAnnouncement(element: HTMLElement | null, text: string, isSilent: boolean) {
    if (!element) return
    element.textContent = isSilent ? `— ${silentText} —` : text
    element.dataset.isSilent = String(isSilent)
  }

  function revealPanels() {
    if (!panels) return
    const rect = panels.getBoundingClientRect()
    // --- Both panels have to be fully in view. Partially visible means the
    // comparison is cut off, which is the same as not seeing it.
    const isFullyVisible = rect.top >= 0 && rect.bottom <= window.innerHeight
    if (isFullyVisible) return
    panels.scrollIntoView({ block: "end", behavior: "smooth" })
  }

  function selectCase(index: number) {
    const announcement = announcements[index]
    if (!announcement) return

    targets.forEach((target, targetIndex) => {
      target.setAttribute("aria-current", targetIndex === index ? "true" : "false")
    })

    const isCommonSilent = announcement.isCommonSilent === true
    const isCorrectSilent = announcement.isCorrectSilent === true

    renderAnnouncement(commonOutput, announcement.common, isCommonSilent)
    renderAnnouncement(correctOutput, announcement.correct, isCorrectSilent)

    // --- Panels are aria-hidden, so the comparison is announced here as one
    // message instead of two competing live regions.
    if (liveRegion) {
      liveRegion.textContent = liveTemplate
        .replace("{common}", isCommonSilent ? silentText : announcement.common)
        .replace("{correct}", isCorrectSilent ? silentText : announcement.correct)
    }
  }

  targets.forEach((target, index) => {
    target.addEventListener("click", (event) => {
      selectCase(index)
      // --- detail is 0 for Enter and Space; scrolling on keyboard activation
      // would move the page out from under the user.
      if (event.detail > 0) revealPanels()
    })

    // --- Keyboard focus selects too, the way a screen reader cursor would
    target.addEventListener("focus", () => {
      if (target.matches(":focus-visible")) selectCase(index)
    })
  })
</script>
