---
// --- A legal text: title, lead, sections, an optional date.
// No heading level badge here: on a legal text it would be decoration.
// A section is a run of blocks: a paragraph (a string), a bullet list
// ({ list }) or a postal address, one line each ({ address }). Every line
// carries the marks of InlineText (links, lang) and placeholders for the
// provider's details, filled from siteConfig, so a translation never holds a
// stale copy of the address, the email or the phone number:
//   {legalName} {street} {postalCode} {city}   plain text
//   {email} {phone}                            a mailto: or tel: link
import InlineText from "../../components/ui/InlineText.astro"
import { siteConfig } from "../../config/site"
import { fill } from "../../i18n/fill"

export type LegalBlock =
  string | { readonly list: readonly string[] } | { readonly address: readonly string[] }

interface Props {
  title: string
  lead: string
  sections: readonly { heading: string; body: readonly LegalBlock[] }[]
  status?: { heading: string; date: string }
}

const { title, lead, sections, status } = Astro.props

const { address, contact, legalName } = siteConfig
const providerDetails = {
  legalName,
  street: address.street,
  postalCode: address.postalCode,
  city: address.city,
  email: `[${contact.email}](mailto:${contact.email})`,
  phone: `[${contact.phoneDisplay}](tel:${contact.phone})`,
}
const filled = (line: string) => fill(line, providerDetails)
---

<main
  id="main"
  class="ec-layout-text-content pt-[calc(var(--spacing-header)+5rem)] pb-20 md:pt-[calc(var(--spacing-header)+7rem)] md:pb-28"
>
  <section>
    <h1 class="ec-reveal text-display text-balance">{title}</h1>

    <p class="mt-8 ec-reveal text-lead text-typo-medium ec-reveal-late">{lead}</p>
  </section>

  {
    sections.map((entry) => (
      <section class="mt-14 ec-reveal">
        <h2 class="text-heading-2">{entry.heading}</h2>

        <div class="mt-4 flex flex-col gap-4 text-body text-typo-medium">
          {entry.body.map((block) =>
            typeof block === "string" ? (
              <p>
                <InlineText text={filled(block)} />
              </p>
            ) : "list" in block ? (
              <ul role="list" class="flex flex-col gap-2">
                {block.list.map((item) => (
                  <li class="flex gap-3 before:mt-[0.7em] before:size-1.5 before:shrink-0 before:rounded-full before:bg-current before:content-['']">
                    <span>
                      <InlineText text={filled(item)} />
                    </span>
                  </li>
                ))}
              </ul>
            ) : (
              <address class="not-italic">
                {block.address.map((line, index) => (
                  <>
                    {index > 0 && <br />}
                    <InlineText text={filled(line)} />
                  </>
                ))}
              </address>
            )
          )}
        </div>
      </section>
    ))
  }

  {
    status && (
      <section class="mt-14 ec-reveal">
        <h2 class="text-heading-2">{status.heading}</h2>
        <p class="mt-4 text-body text-typo-medium">{status.date}</p>
      </section>
    )
  }
</main>
