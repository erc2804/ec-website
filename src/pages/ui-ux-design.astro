---
import BaseLayout from "../layouts/BaseLayout.astro"
import DesignPage from "../views/design/DesignPage.astro"
import { useTranslations } from "../i18n"

const t = useTranslations(Astro.currentLocale).design
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  routeKey="design"
  hasStructuredData
>
  <DesignPage />
</BaseLayout>
