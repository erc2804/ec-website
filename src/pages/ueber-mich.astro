---
import { useTranslations } from "../i18n"
import BaseLayout from "../layouts/BaseLayout.astro"
import AboutPage from "../views/about/AboutPage.astro"
import ProfileSchema from "../views/about/ProfileSchema.astro"

const t = useTranslations("de").about.meta
---

<BaseLayout title={t.title} description={t.description} routeKey="about">
  <ProfileSchema slot="head" />
  <AboutPage />
</BaseLayout>
