---
import { localised, projects } from "../../data/projects"
import { useTranslations } from "../../i18n"
import { fill } from "../../i18n/fill"
import BaseLayout from "../../layouts/BaseLayout.astro"
import ProjectPage from "../../views/portfolio/ProjectPage.astro"

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }))
}

const { project } = Astro.props
const t = useTranslations("de").portfolio.project
const label = localised(project.label, "de")
---

<BaseLayout
  title={fill(t.metaTitle, { label })}
  description={project.summary.de}
  routeKey="portfolio"
  subPath={`/${project.slug}`}
>
  <ProjectPage project={project} />
</BaseLayout>
