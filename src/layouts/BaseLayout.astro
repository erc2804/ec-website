---
import Seo from "../components/Seo.astro"
import SiteFooter from "../components/SiteFooter.astro"
import SiteHeader from "../components/SiteHeader.astro"
import SkipLink from "../components/ui/SkipLink.astro"
import { siteConfig } from "../config/site"
import type { RouteKey } from "../i18n"
import "../styles/global.css"

interface Props {
  title: string
  description: string
  shareImage?: { src: string; alt: string }
  isNoindex?: boolean
  hasStructuredData?: boolean
  routeKey?: RouteKey
  /** --- Path below the route, e.g. "/konux" under the portfolio, for hreflang and the language switch --- */
  subPath?: string
  /** --- Transparent header with light text, for a page that opens on a dark hero --- */
  isHeaderOnDark?: boolean
  /** --- Applied to <body> --- */
  class?: string
}

const {
  title,
  description,
  shareImage,
  isNoindex,
  hasStructuredData,
  routeKey,
  subPath,
  isHeaderOnDark = false,
  class: additionalClasses,
} = Astro.props

const currentLocale = Astro.currentLocale ?? siteConfig.defaultLocale

// --- Target of the skip link. Every page renders exactly one <main> with it.
const mainId = "main"
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <Seo
      title={title}
      description={description}
      shareImage={shareImage}
      isNoindex={isNoindex}
      hasStructuredData={hasStructuredData}
      routeKey={routeKey}
      subPath={subPath}
    />
    <slot name="head" />
  </head>
  <body class:list={[additionalClasses]}>
    <SkipLink targetId={mainId} />

    <SiteHeader routeKey={routeKey} subPath={subPath} isOnDark={isHeaderOnDark} />

    <slot />

    <SiteFooter />
  </body>
</html>

<script>
  // --- Reveal once and stop watching: a block that fades back out on the way up
  // reads as a glitch, not as an entrance.
  const observer = new IntersectionObserver(
    (entries, self) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue
        ;(entry.target as HTMLElement).dataset.isRevealed = "true"
        self.unobserve(entry.target)
      }
    },
    { rootMargin: "0px 0px -10% 0px" }
  )

  for (const target of document.querySelectorAll(".ec-reveal")) observer.observe(target)
</script>
