---
// --- A row of options of which one is chosen: a radio group styled as a pill.
// Arrow keys move the choice, the checked option is filled. Used wherever a
// demo switches between builds, states or situations, so the pill looks the
// same everywhere and sits right once.
//
// Below md a row of pills does not fit, so a native select stands in: the
// same options, the legend as its label. Both stay in the page; the page's
// script keeps them in step (the select has the class ec-segmented-select).
import { IconChevronDown } from "@tabler/icons-astro"

interface Props {
  name: string
  legend: string
  options: { value: string; label: string }[]
  /** --- Value of the option checked at the start; the first by default --- */
  checked?: string
  class?: string
}

const { name, legend, options, checked = options[0]?.value, class: additionalClasses } = Astro.props
const selectId = `${name}Select`
---

<div class:list={["min-w-0", additionalClasses]}>
  <div class="md:hidden">
    <label for={selectId} class="mb-2 block pl-1 text-sm text-typo-medium">{legend}</label>
    <div class="relative w-fit">
      <select
        id={selectId}
        class="ec-segmented-select min-h-11 cursor-pointer appearance-none rounded-full bg-brand-blue py-2 pr-11 pl-5 font-medium text-typo-min"
      >
        {
          options.map((option) => (
            <option value={option.value} selected={option.value === checked}>
              {option.label}
            </option>
          ))
        }
      </select>
      <IconChevronDown
        class="pointer-events-none absolute top-1/2 right-4 size-5 -translate-y-1/2 text-typo-min"
        aria-hidden="true"
      />
    </div>
  </div>

  <fieldset class="min-w-0 max-md:hidden">
    <legend class="mb-2 pl-1 text-sm text-typo-medium">{legend}</legend>
    <div class="flex flex-wrap gap-1 rounded-[1.75rem] border-2 border-gray-low p-1 sm:inline-flex">
      {
        options.map((option) => (
          <label class="flex min-h-11 cursor-pointer items-center rounded-full px-4 text-typo-medium transition-[background-color,color] duration-200 hover:text-typo-high has-checked:bg-brand-blue has-checked:text-typo-min has-focus-visible:outline-4 has-focus-visible:outline-offset-0 has-focus-visible:outline-brand-green-high has-focus-visible:outline-solid">
            <input
              type="radio"
              name={name}
              value={option.value}
              class="sr-only"
              checked={option.value === checked}
            />
            <span class="py-1.75 leading-none">{option.label}</span>
          </label>
        ))
      }
    </div>
  </fieldset>
</div>
