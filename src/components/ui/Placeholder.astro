---
// --- Visible stand-in while a page is only a structure. Removed once the real
// element exists; nothing ships with this component on it.
interface Props {
  label?: string
  class?: string
}

const { label = "Platzhalter", class: additionalClasses } = Astro.props
---

<div
  class:list={[
    "rounded-3xl border-2 border-dashed border-brand-green-high/50 p-6 text-typo-medium",
    additionalClasses,
  ]}
  data-placeholder
>
  <p class="text-label text-brand-green-high uppercase">{label}</p>
  <div class="mt-2"><slot /></div>
</div>
