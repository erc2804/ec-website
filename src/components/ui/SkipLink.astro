---
// --- First focusable element on the page. Hidden until it is focused, then it
// drops into view. WCAG 2.4.1 asks for a way past the header; on this site it is
// also the first thing a keyboard user meets, so it is built to be seen.
import { useTranslations } from "../../i18n"

interface Props {
  /** --- id of the element to jump to --- */
  targetId: string
}

const { targetId } = Astro.props

const t = useTranslations(Astro.currentLocale).nav
---

<a href={`#${targetId}`} class="ec-skip-link no-underline">{t.skipToContent}</a>

<style>
  .ec-skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 60;
    border: 3px solid var(--color-gray-min);
    border-radius: 9999px;
    background: var(--color-brand-blue);
    padding: 0.75rem 1.25rem;
    color: var(--color-typo-min);
    font-weight: 700;
    line-height: 1;
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    /* --- Off screen rather than display:none, so it stays in the tab order --- */
    transform: translateY(-250%);
  }

  /* --- No ring: the link is only ever visible while it has focus, so its
     appearance is the focus indicator. The thick white edge keeps it apart
     from a dark hero and a light page alike. --- */
  .ec-skip-link:focus-visible {
    outline: none;
    transform: translateY(0);
  }
</style>
