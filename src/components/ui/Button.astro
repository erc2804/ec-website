---
// --- Renders <a> when href is set, <button> otherwise.
import { useTranslations } from "../../i18n"

interface Props {
  href?: string
  /** --- "quiet": grey outline, the calm partner of a primary button --- */
  variant?: "primary" | "secondary" | "quiet"
  /** --- "compact" for dense rows such as the header --- */
  size?: "regular" | "compact"
  /** --- Ignored when href is set --- */
  type?: "button" | "submit" | "reset"
  isExternal?: boolean
  class?: string
  /** --- Passed through, e.g. data-inquiry-cta --- */
  [attribute: `data-${string}`]: string | boolean | undefined
}

const {
  href,
  variant = "primary",
  size = "regular",
  type = "button",
  isExternal = false,
  class: additionalClasses,
  ...attributes
} = Astro.props

const t = useTranslations(Astro.currentLocale).common

// --- The icon slot carries the icon, the slot name carries the direction. The
// button never learns which icon it holds, so it stays an atom: an icon before
// the label moves back on hover, one after it moves forward.
const hasIconStart = Astro.slots.has("icon-start")
const hasIconEnd = Astro.slots.has("icon-end")

const Tag = href ? "a" : "button"
const tagProps = href
  ? { href, ...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {}) }
  : { type }

// --- Every variant carries the 2px border, the primary one in transparent, so
// a primary and a quiet button side by side are the same height
const baseClasses =
  "ec-button group inline-flex items-center justify-center gap-2.5 rounded-full border-2 text-center font-bold no-underline transition-colors hyphens-auto"

// --- Whole-pixel line heights: with the body's 1.6 (25.6px) the browser floors
// the fractional half-leading and the label sits 1.5px above the middle; at
// 24px and 20px the capitals sit centred, measured against the icons
const sizeClasses = {
  regular: "min-h-12 px-6 py-2.5 leading-6",
  compact: "min-h-11 px-5 py-2 text-sm leading-5",
}

const variantClasses = {
  primary: "border-transparent bg-brand-green-medium text-brand-blue hover:bg-brand-green-low",
  secondary: "border-brand-green-high text-brand-green-deep hover:bg-brand-green-low/25",
  quiet: "border-gray-low bg-gray-min text-typo-high hover:bg-gray-subtle",
}
---

<Tag
  class:list={[baseClasses, sizeClasses[size], variantClasses[variant], additionalClasses]}
  {...tagProps}
  {...attributes}
>
  {
    hasIconStart && (
      <span class="ec-button-icon" data-direction="start" aria-hidden="true">
        <slot name="icon-start" />
      </span>
    )
  }

  <span>
    <slot />
  </span>

  {
    hasIconEnd && (
      <span class="ec-button-icon" data-direction="end" aria-hidden="true">
        <slot name="icon-end" />
      </span>
    )
  }

  {isExternal && <span class="sr-only">{t.opensInNewTab}</span>}
</Tag>

<style>
  .ec-button-icon {
    display: grid;
    place-items: center;
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .ec-button:hover .ec-button-icon[data-direction="end"],
  .ec-button:focus-visible .ec-button-icon[data-direction="end"] {
    transform: translateX(0.3rem);
  }

  .ec-button:hover .ec-button-icon[data-direction="start"],
  .ec-button:focus-visible .ec-button-icon[data-direction="start"] {
    transform: translateX(-0.3rem);
  }
</style>
