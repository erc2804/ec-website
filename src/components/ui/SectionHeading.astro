---
// --- The heading, with the announcement a screen reader makes for it. The
// heading list is how blind users skim a page, so the page shows its own
// semantics instead of only claiming to get them right.
//
// At rest only the short form shows. When its section takes the viewport the
// quote unfolds. Set in the system font, the same way the caption panels quote
// macOS rather than speaking in the brand voice.
import { useTranslations } from "../../i18n"

interface Props {
  level: 1 | 2
  class?: string
}

const { level, class: additionalClasses } = Astro.props

const t = useTranslations(Astro.currentLocale).common

const Tag = `h${level}` as const
const sizeClass = level === 1 ? "text-display" : "text-heading-1"
const announcement = t.headingLevel.replace("{level}", String(level))
---

<div class:list={["ec-reveal", additionalClasses]}>
  <p class="ec-heading-tag" data-is-active="false" aria-hidden="true">
    <span class="ec-heading-tag-level">H{level}</span>

    <span class="ec-heading-tag-quote"><q>{announcement}</q></span>
  </p>

  <Tag class:list={[sizeClass, "mt-4 text-balance"]}><slot /></Tag>
</div>

<style>
  .ec-heading-tag {
    display: flex;
    align-items: baseline;
    margin: 0;
    max-width: 100%;
    color: currentColor;
    font-size: 0.6875rem;
    line-height: 1.4;
    opacity: 0.7;
  }

  .ec-heading-tag-level {
    flex-shrink: 0;
    font-weight: 700;
    letter-spacing: 0.16em;
    font-variant-numeric: tabular-nums;
  }

  /* --- 0fr to 1fr is the one way to transition to an intrinsic width; the inner
     element carries the overflow so the quote is clipped, never wrapped. Lands
     after the heading has arrived so it follows rather than competes. --- */
  .ec-heading-tag-quote {
    display: grid;
    grid-template-columns: 0fr;
    transition: grid-template-columns 500ms cubic-bezier(0.2, 0.8, 0.2, 1) 380ms;
  }

  .ec-heading-tag[data-is-active="true"] .ec-heading-tag-quote {
    grid-template-columns: 1fr;
  }

  .ec-heading-tag-quote > q {
    overflow: hidden;
    min-width: 0;
    white-space: nowrap;
    /* --- System font on purpose: quoting the screen reader, not our brand --- */
    font-family:
      ui-sans-serif,
      -apple-system,
      "SF Pro Text",
      system-ui,
      sans-serif;
    font-size: 0.75rem;
    letter-spacing: normal;
  }

  /* --- Spacing belongs to the quote, so nothing hangs there while it is closed --- */
  .ec-heading-tag-quote > q::before {
    padding-left: 0.75rem;
  }

  :global(:lang(de)) .ec-heading-tag-quote > q {
    quotes: "„" "“";
  }

  :global(:lang(en)) .ec-heading-tag-quote > q {
    quotes: "“" "”";
  }
</style>

<script>
  const tags = Array.from(document.querySelectorAll<HTMLElement>(".ec-heading-tag"))

  // --- A narrow band across the middle of the viewport: exactly one section
  // holds it at a time, so exactly one quote is open.
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const tag = entry.target.querySelector<HTMLElement>(".ec-heading-tag")
        if (tag) tag.dataset.isActive = String(entry.isIntersecting)
      }
    },
    { rootMargin: "-45% 0px -45% 0px" }
  )

  for (const tag of tags) {
    // --- On a text page the heading has no section around it, and <main> is the
    // scope that is actually in view
    const scope = tag.closest("section") ?? tag.closest("main")
    if (scope) observer.observe(scope)
  }
</script>
