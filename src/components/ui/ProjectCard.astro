---
// --- The project card, built like the offer cards on the start page: a
// light green panel on top, the same for every project, with the mockup
// cropped at the bottom and lifting on hover; below it a white body with the
// name as the link, one sentence on the work and, at the bottom, "More" with
// the arrow that moves on hover. Only the arrow turns green on hover: the text
// would not keep its contrast. The offers a project touched stay on its own
// page. The same card on the start page and in the portfolio. Without a
// picture the panel stands empty.
//
// Card pattern from Inclusive Components: the link is the title only, so its
// name stays short and the title is a real heading. Its ::after stretches over
// the whole card for the click target, lifted with z-10 so the arrow, which
// moves on hover, cannot paint above it and swallow the click. "More" is only
// shown; aria-describedby hands it to the link, as on the start page's offer
// cards. The ring sits on the card, in the card's own shape.
import { IconArrowRight } from "@tabler/icons-astro"
import type { ImageMetadata } from "astro"
import { Picture } from "astro:assets"
import { useTranslations } from "../../i18n"

interface Props {
  href: string
  label: string
  image?: ImageMetadata
  summary: string
  /** --- h3 under a section heading, h2 under the page heading --- */
  headingLevel?: 2 | 3
  class?: string
}

const { href, label, image, summary, headingLevel = 3, class: additionalClasses } = Astro.props

const Heading = `h${headingLevel}` as "h2" | "h3"
const t = useTranslations(Astro.currentLocale).common
// --- One card per project on a page, so the project's slug keeps the id unique
const moreId = `${href.split("/").pop()}More`
// --- The mockup takes half the card: from about 145px in three columns up to
// 370px in one column on a wide phone, three times that on a dense screen
const mockupWidths = [200, 400, 600, 800, 1100]
---

<div
  class:list={[
    "group relative flex h-full flex-col overflow-hidden rounded-3xl bg-gray-min shadow-sm transition-shadow has-[a:focus-visible]:outline-4 has-[a:focus-visible]:outline-offset-4 has-[a:focus-visible]:outline-brand-green-high lg:hover:shadow-lg",
    additionalClasses,
  ]}
>
  <span
    class="relative block aspect-[5/4] overflow-hidden bg-brand-green-low"
    aria-hidden="true"
    inert
  >
    {
      image && (
        <Picture
          src={image}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={mockupWidths}
          sizes="(min-width: 1024px) 12rem, (min-width: 768px) 25vw, 50vw"
          alt=""
          loading="lazy"
          class="absolute inset-x-0 top-7 mx-auto w-[50%] drop-shadow-xl transition-transform duration-300 group-has-[a:focus-visible]:-translate-y-2 lg:group-hover:-translate-y-2"
        />
      )
    }
  </span>
  <div class="flex flex-1 flex-col gap-3 p-6 md:p-7">
    <Heading class="text-heading-2 text-brand-green-high">
      <a
        href={href}
        class="no-underline outline-none after:absolute after:inset-0 after:z-10 after:content-['']"
        aria-describedby={moreId}
      >
        {label}
      </a>
    </Heading>
    <p class="text-typo-medium">{summary}</p>
    <span
      id={moreId}
      class="mt-auto flex items-center gap-2 pt-4 font-bold text-typo-medium"
      aria-hidden="true"
    >
      {t.more}
      <IconArrowRight
        class="size-5 transition-[translate,color] group-hover:translate-x-1 group-hover:text-brand-green-high group-has-[a:focus-visible]:translate-x-1 group-has-[a:focus-visible]:text-brand-green-high"
      />
    </span>
  </div>
</div>
