---
// --- The portfolio card from the previous site: a coloured surface by project
// type, the mockup lifting on hover, a white strip with name and one sentence
// on what I did there.
import type { ProjectType } from "../../data/projects"

interface Props {
  href: string
  /** --- Ties the summary to the link, so it is read after the name --- */
  slug: string
  label: string
  type: ProjectType
  image: string
  summary: string
  /** --- Spoken instead of the visible name, e.g. "Go to project: KONUX" --- */
  ariaLabel?: string
  class?: string
}

const { href, slug, label, type, image, summary, ariaLabel, class: additionalClasses } = Astro.props
const summaryId = `project-summary-${slug}`

const surfaceClasses: Record<ProjectType, string> = {
  web: "bg-brand-green-medium",
  app: "bg-brand-green-high",
  shop: "bg-brand-green-low",
  other: "bg-brand-blue",
}
---

<a
  href={href}
  aria-label={ariaLabel}
  aria-describedby={ariaLabel ? summaryId : undefined}
  class:list={[
    "group relative block aspect-[3/4] overflow-hidden rounded-3xl no-underline shadow-sm transition-shadow lg:hover:shadow-lg",
    surfaceClasses[type],
    additionalClasses,
  ]}
>
  <img
    src={image}
    alt=""
    width="1413"
    height="2916"
    loading="lazy"
    class="size-full object-contain pt-6 transition-transform lg:group-hover:-translate-y-3"
  />
  <span
    class="absolute inset-x-0 bottom-0 flex flex-col gap-2 bg-gray-min px-4 pt-4 pb-5"
    aria-hidden={ariaLabel ? "true" : undefined}
  >
    <span class="text-heading-2 text-brand-green-high">{label}</span>
    <span id={summaryId} class="line-clamp-2 text-typo-medium">{summary}</span>
  </span>
</a>
