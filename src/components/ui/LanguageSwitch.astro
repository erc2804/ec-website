---
// --- Each language names itself and carries lang, so a screen reader announces
// "English" in an English voice rather than reading it with a German one. The
// visible code comes first in the name ("EN, English"), so voice control can
// target it by what is on screen (WCAG 2.5.3, label in name).
//
// Both options in the full text colour; the current one is marked the same way
// as the current page in the navigation, with the green bar under the label.
// A thin drawn rule separates the two, decorative and hidden from assistive
// technology. Every option is a 44px target.
import { localeNames, localisedPath, useTranslations, type Locale, type RouteKey } from "../../i18n"
import { siteConfig } from "../../config/site"

interface Props {
  routeKey: RouteKey
  currentLocale: Locale
  class?: string
}

const { routeKey, currentLocale, class: additionalClasses } = Astro.props

const t = useTranslations(currentLocale).nav

const optionClasses =
  "relative grid size-11 place-items-center rounded-full text-sm font-bold tracking-[0.06em]"
---

<div
  class:list={["flex items-center gap-1", additionalClasses]}
  role="group"
  aria-label={t.languageLabel}
>
  {
    siteConfig.locales.map((locale, index) => (
      <>
        {index > 0 && <span class="h-4 w-0.5 bg-current opacity-40" aria-hidden="true" />}
        {locale === currentLocale ? (
        <span
          class:list={[
            optionClasses,
            "after:absolute after:bottom-1.5 after:h-1 after:w-5 after:rounded-full after:bg-brand-green-medium",
          ]}
          aria-current="true"
          lang={locale}
        >
          <span>{localeNames[locale].short}</span>
          <span class="sr-only">, {localeNames[locale].full}</span>
        </span>
      ) : (
        <a
          class:list={[optionClasses, "no-underline transition-colors hover:bg-current/10"]}
          href={localisedPath(routeKey, locale)}
          lang={locale}
          hreflang={locale}
        >
          <span>{localeNames[locale].short}</span>
          <span class="sr-only">, {localeNames[locale].full}</span>
        </a>
        )}
      </>
    ))
  }
</div>
