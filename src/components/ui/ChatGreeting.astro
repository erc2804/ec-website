---
// --- The touch counterpart of the mouse bubble: the avatar pops up once next
// to its anchor, says one line, and leaves again. Nothing stays on screen, so
// the gimmick costs no space on a phone. Decorative, hidden from assistive
// technology, and skipped entirely under prefers-reduced-motion.
interface Props {
  message: string
  class?: string
}

const { message, class: additionalClasses } = Astro.props
---

<span
  class:list={["ec-chat-greeting hidden items-center gap-2", additionalClasses]}
  aria-hidden="true"
  inert
>
  <span
    class="ec-chat-greeting-avatar size-8 shrink-0 -rotate-90 scale-0 overflow-hidden rounded-full bg-brand-sand transition-transform duration-500"
  >
    <img src="/images/pixelcan.png" alt="" width="32" height="32" class="size-full" />
  </span>
  <span
    class="ec-chat-greeting-text rounded-xl bg-brand-sand px-2 py-0.5 text-sm tracking-normal normal-case opacity-0 transition-opacity delay-200 duration-500"
  >
    {message}
  </span>
</span>

<script>
  const isTouch = window.matchMedia("(hover: none) and (pointer: coarse)").matches
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches

  if (isTouch && !prefersReducedMotion) {
    for (const greeting of document.querySelectorAll<HTMLElement>(".ec-chat-greeting")) {
      const avatar = greeting.querySelector<HTMLElement>(".ec-chat-greeting-avatar")!
      const text = greeting.querySelector<HTMLElement>(".ec-chat-greeting-text")!

      // --- After the hero lines have risen in, on screen for three seconds
      window.setTimeout(() => {
        greeting.classList.remove("hidden")
        greeting.classList.add("inline-flex")
        requestAnimationFrame(() => {
          avatar.classList.remove("-rotate-90", "scale-0")
          text.classList.remove("opacity-0")
        })

        window.setTimeout(() => {
          avatar.classList.add("-rotate-90", "scale-0")
          text.classList.add("opacity-0")
          window.setTimeout(() => {
            greeting.classList.add("hidden")
            greeting.classList.remove("inline-flex")
          }, 600)
        }, 3000)
      }, 1200)
    }
  }
</script>
