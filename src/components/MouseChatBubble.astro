---
// --- The pixel avatar that follows the cursor and comments on whatever it is
// over. It only appears inside areas marked data-chat-zone; everywhere else it
// steps aside, so a new section stays quiet unless it asks for him. He says the
// nearest data-chat above the cursor: a zone carries a default line for all of
// it, an element inside with its own line wins there. data-chat-mute sends him
// away again (e.g. a control someone is operating). While a popover is open, or
// the cursor is outside the window, he steps aside too. Pointer only: on touch
// there is no cursor to follow, and a bubble parked in a corner would cost
// screen space for a gimmick. Decorative throughout, so hidden from assistive
// technology. Escape sends him away for the rest of the visit (WCAG 1.4.13:
// content on hover can be dismissed without moving the pointer): one last
// line, then he leaves.
import { useTranslations } from "../i18n"

const t = useTranslations(Astro.currentLocale).chatBubble
---

<div
  class="ec-chat-bubble group pointer-events-none fixed z-50 hidden w-max flex-col items-end gap-1"
  data-starter={t.starter}
  data-dismissed={t.dismissed}
  data-is-on-dark="true"
  aria-hidden="true"
  inert
>
  <div
    class="ec-chat-avatar size-10 shrink-0 scale-0 -rotate-90 overflow-hidden rounded-full bg-brand-sand transition-transform duration-500"
  >
    <img src="/images/pixelcan.png" alt="" width="40" height="40" class="size-full" />
  </div>
  <div
    class="ec-chat-text flex min-h-6 max-w-50 items-center rounded-xl bg-brand-sand px-2 pt-px text-sm text-typo-high opacity-0 [transition:opacity_500ms,background-color_300ms,color_300ms] group-data-[is-on-dark=false]:bg-gray-max/85 group-data-[is-on-dark=false]:text-brand-sand"
  >
    <span class="ec-chat-message"></span>
    <span class="ec-chat-typing hidden items-center gap-1 py-2">
      <span
        class="size-1.5 animate-bounce rounded-full bg-brand-green-high group-data-[is-on-dark=false]:bg-brand-green-medium"
      ></span>
      <span
        class="size-1.5 animate-bounce rounded-full bg-brand-green-high [animation-delay:150ms] group-data-[is-on-dark=false]:bg-brand-green-medium"
      ></span>
      <span
        class="size-1.5 animate-bounce rounded-full bg-brand-green-high [animation-delay:300ms] group-data-[is-on-dark=false]:bg-brand-green-medium"
      ></span>
    </span>
  </div>
</div>

<script>
  const bubble = document.querySelector<HTMLElement>(".ec-chat-bubble")

  // --- Primary input can hover and is precise: a mouse or trackpad. A hybrid
  // device that reports touch first still switches over once a real mouse moves.
  const hasMouse = () => window.matchMedia("(hover: hover) and (pointer: fine)").matches

  // --- A gimmick that moves with the cursor is exactly what someone asking for
  // reduced motion does not want, and its lines carry no information. So it
  // does not appear at all then, and leaves if the setting is switched on
  // while the page is open.
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")

  // --- Dismissed once, gone for the visit; storage can be blocked, then he
  // only stays away on this page
  const dismissedKey = "ec-chat-bubble-dismissed"
  const isDismissedForVisit = () => {
    try {
      return sessionStorage.getItem(dismissedKey) === "true"
    } catch {
      return false
    }
  }

  const start = () => {
    if (!bubble || reducedMotion.matches || bubble.dataset.isActive === "true") return
    if (isDismissedForVisit()) return
    bubble.dataset.isActive = "true"
    bubble.classList.remove("hidden")
    bubble.classList.add("flex")

    const avatar = bubble.querySelector<HTMLElement>(".ec-chat-avatar")!
    const text = bubble.querySelector<HTMLElement>(".ec-chat-text")!
    const message = bubble.querySelector<HTMLElement>(".ec-chat-message")!
    const typing = bubble.querySelector<HTMLElement>(".ec-chat-typing")!

    // --- waiting: not arrived yet. starter: the opener is being read and
    // nothing replaces it. live: he comments on what the cursor is over.
    let phase: "waiting" | "starter" | "live" = "waiting"
    let isShown = false
    let shownMessage = bubble.dataset.starter ?? ""
    let wantedMessage = shownMessage
    let isTyping = false
    let typingTimer = 0
    let pointer: { x: number; y: number } | null = null
    let hasMoved = false
    let lineZone: HTMLElement | null = null
    let hasElementLine = false
    let isDismissed = false

    message.textContent = shownMessage

    // --- The bubble is as wide as its line, never squeezed by the edge. The
    // clamp uses that width, so he stops short of the left edge instead, and
    // a longer line arriving there pushes him back in.
    const place = () => {
      if (!pointer) return
      const avatarSize = 40
      const safeSpace = 12
      // --- top and right of a fixed element count from the viewport without
      // its scrollbar, which innerWidth would include
      const { clientWidth: viewportWidth, clientHeight: viewportHeight } = document.documentElement
      const maxTop = viewportHeight - bubble.offsetHeight - 64
      const maxRight = viewportWidth - bubble.offsetWidth - 3

      const top = Math.min(Math.max(80, pointer.y - avatarSize / 2), maxTop)
      const right = Math.min(
        Math.max(0, viewportWidth - pointer.x - avatarSize - safeSpace * 2),
        maxRight
      )

      bubble.style.top = `${top}px`
      bubble.style.right = `${right}px`
    }

    // --- Arriving and leaving are the same motion, one the reverse of the
    // other. In: the avatar turns and grows, then the line fades in behind it.
    // Out: the line fades first, then the avatar turns back and shrinks away.
    const setShown = (shouldShow: boolean) => {
      if (shouldShow === isShown) return
      isShown = shouldShow
      avatar.style.transitionDelay = shouldShow ? "0ms" : "300ms"
      // --- Listed per transitioned property: only the fade waits, a change of
      // ground recolours the line at once
      text.style.transitionDelay = shouldShow ? "300ms, 0ms, 0ms" : "0ms"
      avatar.classList.toggle("-rotate-90", !shouldShow)
      avatar.classList.toggle("scale-0", !shouldShow)
      text.classList.toggle("opacity-0", !shouldShow)
    }

    const showWantedMessage = () => {
      window.clearTimeout(typingTimer)
      isTyping = false
      shownMessage = wantedMessage
      message.textContent = shownMessage
      typing.classList.add("hidden")
      typing.classList.remove("flex")
      message.classList.remove("hidden")
      place()
    }

    // --- No queue: whatever the cursor points at while he types replaces the
    // line he is typing, and when the dots end he says only the latest one.
    const say = (next: string, isInstant: boolean) => {
      wantedMessage = next
      if (isInstant) return showWantedMessage()
      if (isTyping || next === shownMessage) return
      isTyping = true
      message.classList.add("hidden")
      typing.classList.remove("hidden")
      typing.classList.add("flex")
      place()
      typingTimer = window.setTimeout(showWantedMessage, 1000)
    }

    // --- Everything is read again from what lies under the cursor right now,
    // so no earlier event can leave him in a stale state. He shows only
    // inside a zone, and says the nearest data-chat above the cursor.
    const react = (target: Element | null) => {
      if (!target || isDismissed) return

      const zone = target.closest<HTMLElement>("[data-chat-zone]")
      const isMuted =
        zone === null ||
        target.closest("[data-chat-mute]") !== null ||
        document.querySelector(":popover-open") !== null

      // --- Once something inside a zone gave him a line, the zone's own default
      // stays quiet until he leaves the zone. Otherwise every gap between two
      // elements would flip him back and he would be typing all the time.
      const source = target.closest<HTMLElement>("[data-chat]")
      const isZoneDefault = source !== null && source === zone
      if (isMuted || zone !== lineZone) {
        lineZone = isMuted ? null : zone
        hasElementLine = false
      }
      if (source && !isZoneDefault) hasElementLine = true
      const line = isZoneDefault && hasElementLine ? undefined : source?.dataset.chat

      // --- Sand on dark ground, and on light ground the dark of the tooltips in
      // the offer cards, so he stays readable everywhere. ec-on-dark marks the
      // dark surfaces, the header carries data-is-on-dark over a dark hero.
      if (!isMuted) {
        const isOnDark = target.closest(".ec-on-dark, [data-is-on-dark='true']") !== null
        bubble.dataset.isOnDark = String(isOnDark)
      }

      if (phase === "waiting") return
      const isComingBack = !isShown && !isMuted
      setShown(!isMuted)

      // --- Coming back, he already knows where he is: the line of this spot is
      // in place before he fades in, no typing for an old one.
      if (phase === "live" && !isMuted && line) say(line, isComingBack)
    }

    const reactAtPointer = () => {
      if (pointer) react(document.elementFromPoint(pointer.x, pointer.y))
    }

    // --- Arrives after a moment, and the opener stays long enough to be read.
    // Anything pointed at before that is gone, not saved for later.
    const arriveLater = () => {
      window.setTimeout(() => {
        phase = "starter"
        reactAtPointer()
        window.setTimeout(() => (phase = "live"), 1500)
      }, 2000)
    }

    // --- Escape while he is visible and nothing else is open (a dialog or the
    // menu closes on Escape itself): his last line, a moment to read it, gone
    document.addEventListener("keydown", (event: KeyboardEvent) => {
      if (event.key !== "Escape" || !isShown || isDismissed) return
      if (document.querySelector("dialog[open], :popover-open")) return
      isDismissed = true
      try {
        sessionStorage.setItem(dismissedKey, "true")
      } catch {
        // --- Storage blocked: he stays away on this page only
      }
      wantedMessage = bubble.dataset.dismissed ?? ""
      showWantedMessage()
      window.setTimeout(() => setShown(false), 1500)
    })

    document.addEventListener("mousemove", (event: MouseEvent) => {
      pointer = { x: event.clientX, y: event.clientY }
      place()
      if (!hasMoved) {
        hasMoved = true
        arriveLater()
      }
      react(event.target instanceof Element ? event.target : null)
    })

    // --- The cursor left the window: he leaves too instead of waiting at the
    // edge, and comes back with the next move inside.
    document.addEventListener("mouseout", (event: MouseEvent) => {
      if (event.relatedTarget !== null) return
      pointer = null
      setShown(false)
    })

    // --- Scrolling moves the page under a resting cursor, so a muted section
    // can arrive without the mouse moving. Check what lies under it again.
    let isScrollPending = false
    window.addEventListener(
      "scroll",
      () => {
        if (!pointer || isScrollPending) return
        isScrollPending = true
        requestAnimationFrame(() => {
          isScrollPending = false
          reactAtPointer()
        })
      },
      { passive: true }
    )
  }

  reducedMotion.addEventListener("change", () => {
    if (!bubble) return
    if (bubble.dataset.isActive !== "true") {
      if (hasMouse()) start()
      return
    }
    bubble.classList.toggle("hidden", reducedMotion.matches)
    bubble.classList.toggle("flex", !reducedMotion.matches)
  })

  if (hasMouse()) {
    start()
  } else {
    document.addEventListener(
      "pointermove",
      (event) => {
        if (event.pointerType === "mouse") start()
      },
      { once: true }
    )
  }
</script>
