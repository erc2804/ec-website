---
// --- The offer pages' "how I can help": a title, a lead and three cards, each
// with an icon, like the offer cards on the start page. On the grey page ground
// the cards are white with a shadow; on a light section they are grey without
// one. Shared, so the pages cannot drift apart.
import type { IconCheck } from "@tabler/icons-astro"
import Section from "./ui/Section.astro"
import { surfaceOnGroundClasses, type Ground } from "./ui/surfaceOnGround"

interface Props {
  title: string
  lead: string
  items: { title: string; text: string }[]
  /** --- One icon component per item, in the same order: a Tabler icon or a
       drawn one that takes `class` --- */
  icons: (typeof IconCheck | ((props: { class?: string }) => unknown))[]
  tone?: Ground
}

const { title, lead, items, icons, tone = "page" } = Astro.props

const cardClasses = surfaceOnGroundClasses[tone]
---

<Section tone={tone}>
  <h2 class="ec-reveal text-heading-1 text-balance">{title}</h2>
  <p class="mt-5 max-w-[52ch] ec-reveal text-lead text-typo-medium ec-reveal-late">{lead}</p>

  <!-- --- Subgrid rows, so icon, title and text line up across the three
       however long each title is -->
  <ul role="list" class="mt-12 grid gap-6 md:grid-cols-3 md:gap-y-0">
    {
      items.map((service, index) => {
        const ServiceIcon = icons[index]
        return (
          <li
            class:list={[
              "flex ec-reveal flex-col rounded-3xl p-6 md:row-span-3 md:grid md:grid-rows-subgrid md:p-8",
              cardClasses,
            ]}
            style={`--ec-reveal-delay: ${index * 110}ms`}
          >
            <span
              class="grid size-12 place-items-center rounded-full bg-brand-green-low/70 text-brand-blue"
              aria-hidden="true"
            >
              <ServiceIcon class="size-6" />
            </span>
            <h3 class="mt-6 text-heading-2 text-balance">{service.title}</h3>
            <p class="mt-3 text-typo-medium">{service.text}</p>
          </li>
        )
      })
    }
  </ul>
</Section>
