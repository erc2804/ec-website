---
// --- The offer pages' "how I can help": a title, a lead and three white cards
// on the grey ground, each with an icon, like the offer cards on the start page.
// Shared, so the pages cannot drift apart.
import type { IconCheck } from "@tabler/icons-astro"
import Section from "./ui/Section.astro"

interface Props {
  title: string
  lead: string
  items: { title: string; text: string }[]
  /** --- One Tabler icon component per item, in the same order --- */
  icons: (typeof IconCheck)[]
}

const { title, lead, items, icons } = Astro.props
---

<Section aria-labelledby="servicesTitle">
  <h2 id="servicesTitle" class="ec-reveal text-heading-1 text-balance">{title}</h2>
  <p class="mt-5 max-w-[52ch] ec-reveal text-lead text-typo-medium ec-reveal-late">{lead}</p>

  <!-- --- Subgrid rows, so icon, title and text line up across the three
       however long each title is -->
  <ul role="list" class="mt-12 grid gap-6 md:grid-cols-3 md:gap-y-0">
    {
      items.map((service, index) => {
        const ServiceIcon = icons[index]
        return (
          <li
            class="flex ec-reveal flex-col rounded-3xl bg-gray-min p-6 shadow-sm md:row-span-3 md:grid md:grid-rows-subgrid md:p-8"
            style={`--ec-reveal-delay: ${index * 110}ms`}
          >
            <span
              class="grid size-12 place-items-center rounded-full bg-brand-green-low/70 text-brand-blue"
              aria-hidden="true"
            >
              <ServiceIcon class="size-6" />
            </span>
            <h3 class="mt-6 text-heading-2 text-balance">{service.title}</h3>
            <p class="mt-3 text-typo-medium">{service.text}</p>
          </li>
        )
      })
    }
  </ul>
</Section>
